# Generated cert files — run infra/certs/gen-certs.sh to create locally
infra/certs/*.key
infra/certs/*.crt
infra/certs/*.csr
infra/certs/*.srl
# Kong admin API keys, generated by kong-setup.sh when ENABLE_ADMIN_KEY_AUTH=1
infra/certs/admin-keys.env

# Model weights — large binary files, download separately
model/ollama/weights/*.gguf
# Docling (HF layout/OCR) + RapidOCR weights — pre-downloaded, bind-mounted into
# the ingestion worker (docker-compose.kb_and_authen.yml). Large binaries.
model/docling-model/weights/
# model-service embed/rerank weights — downloaded at runtime into this mounted volume
infra/model-service/models/

# Kafka credential files — contain real passwords; use *.example templates instead
infra/kafka/kafka-broker-jaas.config
infra/kafka/admin_release.props
infra/kafka/rw.props

# Standalone demo/observability visualizer pages — not part of the app build
*-visualizer.html

# Transient stack bring-up / helper logs and crash dumps
*.stackdump
.kong-bringup.log
infra/.*-up.log
