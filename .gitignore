.claude/settings.json
.claude/settings.local.json

# Generated cert files — run deploy/docker/certs/gen-certs.sh to create locally
deploy/docker/certs/*.key
deploy/docker/certs/*.crt
deploy/docker/certs/*.csr
deploy/docker/certs/*.srl
# Kong admin API keys, generated by kong-setup.sh when ENABLE_ADMIN_KEY_AUTH=1
deploy/docker/certs/admin-keys.env

# model_service embed/rerank weights — downloaded at runtime into this mounted volume
backend/services/model_service/models/

# UI design files — reference only, không commit
Data_Agent_UI/

# Kafka credential files — contain real passwords; use *.example templates instead
deploy/docker/kafka/kafka-broker-jaas.config

# Standalone demo/observability visualizer pages — not part of the app build
*-visualizer.html

# Transient stack bring-up / helper logs and crash dumps
*.stackdump
.kong-bringup.log
deploy/docker/.*-up.log

# Evaluation artifacts. The CORPUS is versioned (model/eval/cases/*.jsonl); these
# are derived from it per run — a committed report goes stale the moment the code
# it graded changes, and a stale one is worse than none.
eval-report.json
.eval-reports/
# Requirement-coverage runs and bug evidence bundles (docs/v2/15-test-strategy.md §7, §10):
# attached to the Linear issue, not committed.
.req-reports/
.evidence/
frontend/scripts/ui-demo-shots/
tests/e2e/out/

# ansible: real inventories/secrets stay local
deploy/ansible/inventories/*/.secrets/
deploy/ansible/inventories/prod/hosts.yml
deploy/ansible/inventories/prod/group_vars/all.yml
# NOT vault.yml: an ansible-vault file is ciphertext on disk and is meant to be
# committed. Committing it is what lets the deploy pipeline see "the secrets
# changed in this pull" from a git diff. Only the vault PASSWORD stays out of
# the repo (ANSIBLE_VAULT_PASSWORD_FILE). A plaintext copy must not be:
deploy/ansible/inventories/*/group_vars/all/vault.plain.yml
.ansible-secrets/
deploy/docker/keycloak/spi/target/

# filled-in secret source for deploy/k8s/create-secrets.sh
deploy/k8s/secrets.env
deploy/k8s/.openbao-keys.json
deploy/k8s/dev/secrets.env
deploy/k8s/dev/.openbao-keys.json
deploy/k8s/dev/.openbao-env.yml
/tmp/

# Serving-benchmark artifacts. Same rule as the eval reports above: an ad-hoc
# run is derived data and goes stale immediately. A baseline someone deliberately
# recorded is different — it is the evidence a later optimisation is judged
# against — and lives versioned in model/bench/baselines/.
bench-report.json
bench-baseline*.json
e2e-report.json
