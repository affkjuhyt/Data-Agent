{"id": "sql-014", "catalog": "retail", "question": "doanh thu theo tháng", "request": {"grain": "month", "dialect": "clickhouse"}, "expect": {"metric": "revenue", "sql_contains": ["toStartOfMonth(created_at) AS period"], "sql_not_contains": ["DATE_TRUNC"]}, "tag": "dialect"}
{"id": "sql-015", "catalog": "retail", "question": "doanh thu các miền bắc và trung", "request": {"filters": [{"column": "region", "op": "in", "value": ["mien_bac", "mien_trung"]}]}, "expect": {"metric": "revenue", "sql_contains": ["region IN ('mien_bac', 'mien_trung')"], "sql_not_contains": []}, "tag": "filter-op"}
{"id": "sql-016", "catalog": "retail", "question": "doanh thu không tính miền nam", "request": {"filters": [{"column": "region", "op": "not_in", "value": ["mien_nam"]}]}, "expect": {"metric": "revenue", "sql_contains": ["region NOT IN ('mien_nam')"], "sql_not_contains": []}, "tag": "filter-op"}
