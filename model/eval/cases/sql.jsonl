{"id": "sql-019", "catalog": "retail", "question": "thời tiết hôm nay thế nào?", "request": {}, "expect": {"metric": null, "reason": "no-metric"}, "tag": "no-false-match", "note": "Most questions are not about a registered metric. Resolving one anyway would answer a question nobody asked."}
{"id": "sql-020", "catalog": "retail", "question": "doanh thu theo phòng ban", "request": {"dimensions": ["department"]}, "expect": {"metric": "revenue", "error": "UnsupportedRequest"}, "tag": "hallucinated-dimension", "note": "'department' is not in the contract. Failing loudly beats emitting SQL against a column that does not exist."}
