# Source of truth for every per-workload Secret.
# Fill in, then:  set -a; . ./secrets.env; set +a; bash deploy/k8s/create-secrets.sh
# git-ignored — never commit a filled copy.

# Passwords for the three non-owner Postgres roles. The db-init Job runs
# ALTER ROLE with these, so the role and the DSN below cannot drift apart.
# APP_USER_PW / RUNTIME_WRITER_PW in the URLs must be the same values.

APP_DATABASE_URL=postgresql://app_user:APP_USER_PW@postgres.dataagent-database.svc.cluster.local:8300/dataagent
APP_USER_PASSWORD=
# kb-backend's own table-scoped role (deploy/docker/sql/grant-roles.sql).
# Routed through PgBouncer; the role is forwarded upstream so RLS still applies.
KB_BACKEND_PASSWORD=
KB_BACKEND_URL_ASYNC=postgresql+asyncpg://kb_backend:KB_BACKEND_PW@pgbouncer.dataagent-database.svc.cluster.local:8390/dataagent
# Role PgBouncer uses for auth_query only. Not a superuser.
PGBOUNCER_AUTH_PASSWORD=
# V3 database logins as JSON, e.g. {"svc_qa":"…","svc_org":"…"} (vault_db_role_passwords)
DB_ROLE_PASSWORDS={}
# The KB workers' (kb-promote-*, kb-structured-data, kb-conflict-resolution)
# table-scoped role kb_ingestion_worker (deploy/docker/sql/grant-roles.sql).
KB_INGESTION_WORKER_PASSWORD=
# V2 crawler role (ADR-V2-46): web crawler writes to ingest.artifact / ingest.fetch.
CRAWLER_SVC_PASSWORD=
KB_INGESTION_WORKER_URL_ASYNC=postgresql+asyncpg://kb_ingestion_worker:KB_INGESTION_WORKER_PW@postgres.dataagent-database.svc.cluster.local:8300/dataagent
AUDIT_CONSUMER_KAFKA_PASSWORD=
CLICKHOUSE_CRAWLER_PASSWORD=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_USER=
DATABASE_URL=postgresql://admin:PW@postgres.dataagent-database.svc.cluster.local:8300/dataagent
EVAL_AGENT_ID=
GATEWAY_KEY=
GEMINI_API_KEY=
GRAFANA_ADMIN_PASSWORD=
KAFKA_ADMIN_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PUBLIC_URL=https://sso.example.vn
LANGFUSE_DATABASE_URL=postgresql://admin:PW@postgres.dataagent-database.svc.cluster.local:8300/langfuse
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_EMAIL=admin@example.com
LANGFUSE_INIT_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_PUBLIC_URL=https://langfuse.example.vn
LANGFUSE_SALT=
LANGFUSE_SECRET_KEY=
LITELLM_API_KEY=
LITELLM_DATABASE_URL=postgresql://admin:PW@postgres.dataagent-database.svc.cluster.local:8300/litellm
MEMORY_CONSUMER_KAFKA_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_URL=http://minio:PW@minio.dataagent-database.svc.cluster.local:8360
NEO4J_AUTH=neo4j/PW
OPENAI_API_KEY=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_TOKEN=
POSTGRES_CRAWLER_PASSWORD=
POSTGRES_PASSWORD=
PUBLIC_API_URL=https://dataagent.example.vn
REMOTE_API_KEY=
REMOTE_LLM_KEY=
RUNTIME_DB_URL=postgresql+asyncpg://runtime_writer:RUNTIME_WRITER_PW@postgres.dataagent-database.svc.cluster.local:8300/dataagent
RUNTIME_WRITER_PASSWORD=
SANDBOX_READER_PASSWORD=
SCHEMA_CRAWLER_WORKER_KAFKA_PASSWORD=
SERVICE_AUTH_SECRET=
SMOKE_PASSWORD=
SNOWFLAKE_CRAWLER_PASSWORD=
WORKFLOW_RUNTIME_KAFKA_PASSWORD=
