---
# Copy to vault.yml, fill in, then encrypt it:
#
#   cp vault.yml.example vault.yml
#   $EDITOR vault.yml
#   ansible-vault encrypt vault.yml
#   ansible-vault edit vault.yml      # from then on
#
# The ENCRYPTED vault.yml is meant to be committed. That is what makes
# `git diff` able to say "the secrets changed in this pull" at all, and it is
# safe: the file on disk is ciphertext. Only the vault password stays out of
# the repo (ansible.cfg reads it from ANSIBLE_VAULT_PASSWORD_FILE).
#
# Composite values -- every DSN, MINIO_URL, NEO4J_AUTH -- are NOT here. They
# are derived from these passwords in group_vars/all/secrets.yml so that a
# password and the URL embedding it cannot drift apart.
#
# Generate a value:  openssl rand -hex 32
# Avoid @ : / ? # and whitespace in any password that lands in a DSN -- those
# characters change how the URL parses, and the failure surfaces much later as
# an auth error against the wrong host.

# ── Postgres roles ────────────────────────────────────────────────────
vault_postgres_password: ""
vault_app_user_password: ""
vault_sandbox_reader_password: ""
vault_pgbouncer_auth_password: ""
# V3 database: a password per service role (svc_org, svc_governance, svc_integration,
# svc_catalog, svc_context, svc_qa, svc_query, svc_agent, svc_eval, svc_inbox, svc_workspace,
# svc_skill, svc_monitor, svc_notify, svc_document, svc_conflict, svc_pack, svc_period,
# svc_pipeline, svc_ingest, svc_acquire, svc_forecast, svc_exec, svc_exec_worker, svc_audit,
# svc_outbox_relay: the outbox relay worker-agent claims events with).
# A role left out stays NOLOGIN.
vault_db_role_passwords: {}

# ── other stores ──────────────────────────────────────────────────────
vault_neo4j_password: ""
vault_clickhouse_password: ""
vault_minio_root_password: ""
# MinIO user worker-agent: writes answer exports to da-exports, nothing else (minio-init).
vault_worker_agent_minio_password: ""
# The crawler's MinIO user: Put/Get on da-raw-crawl only (minio-init).
vault_crawler_minio_password: ""

# ── Kafka SASL, one principal per consumer ────────────────────────────
vault_kafka_admin_password: ""
vault_audit_consumer_kafka_password: ""
vault_memory_consumer_kafka_password: ""
vault_schema_crawler_worker_kafka_password: ""

# ── identity and gateway ──────────────────────────────────────────────
vault_keycloak_admin_password: ""
vault_gateway_key: ""
vault_service_auth_secret: ""
vault_smoke_password: ""
# Demo users' Keycloak passwords (kong-setup.sh sets them; empty = leave as is).
# The e2e suite logs in with these: tests/README.md, e2e.
vault_demo_password_platform_admin: ""
vault_demo_password_helios_admin: ""
vault_demo_password_helios_engineer: ""
vault_demo_password_helios_viewer: ""
vault_demo_password_ai_engineer: ""
vault_demo_password_executive_viewer: ""

# ── LLM tier ──────────────────────────────────────────────────────────
vault_litellm_api_key: ""
vault_openai_api_key: ""
vault_gemini_api_key: ""
vault_remote_api_key: ""
vault_remote_llm_key: ""

# ── observability ─────────────────────────────────────────────────────
vault_langfuse_salt: ""
vault_langfuse_encryption_key: ""
vault_langfuse_nextauth_secret: ""
vault_langfuse_public_key: ""
vault_langfuse_secret_key: ""
vault_langfuse_init_password: ""
vault_grafana_admin_password: ""
