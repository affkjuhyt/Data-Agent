# GENERATED BY ANSIBLE from group_vars/all/secrets.yml + the encrypted vault.
# Do not edit by hand: the next `ansible-playbook deploy.yml` overwrites it.
#
#   env:   {{ env_name }}
#   keys:  {{ (secret_env | combine(openbao_env)) | length }}
#
# Consumed by deploy/k8s/create-secrets.sh, which decides which key reaches
# which workload. Values are single-quoted so a password containing a space,
# '#' or '$' survives `set -a; . secrets.env`.
{% for key, value in (secret_env | combine(openbao_env)) | dictsort %}
{{ key }}={{ value | string | quote }}
{% endfor %}
