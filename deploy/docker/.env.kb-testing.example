# Env for the kb_e2e stack (deploy/docker/docker-compose.kb_e2e.yml).
#
#   Copy-Item deploy/docker/.env.kb-testing.example deploy/docker/.env.kb-testing
#   docker compose -f deploy/docker/docker-compose.kb_e2e.yml --env-file deploy/docker/.env.kb-testing up -d --build
#
# The stack boots with this file empty — every value has a working default in the
# compose file. The one thing you almost always want to set is the LLM tunnel below;
# without it /generate returns 503 and gold-stage entity extraction fails silently.
# Storage credentials (MinIO, Postgres, etc.) are hardcoded in the compose file and
# are NOT read from here.

# ── LLM backend (model-service /generate → OpenAI-compatible endpoint) ──────────
# All LLM calls (gold entity extraction, conflict detection, LightRAG canonicalize)
# go through model-service. Set REMOTE_LLM_URL to point it at your LLM.
#
# Three options (pick ONE):
#
# (a) REMOTE vLLM — Colab GPU + cloudflared tunnel (see model/vllm/):
#         REMOTE_LLM_URL=https://<your-tunnel>.trycloudflare.com
#         REMOTE_LLM_KEY=<your-api-key>
#     The Colab notebook prints TUNNEL_URL and API_KEY on startup.
#     Tunnel URLs rotate on each Colab restart — update here and recreate model-service:
#         docker compose -f deploy/docker/docker-compose.kb_e2e.yml --env-file deploy/docker/.env.kb-testing up -d --no-deps model-service
#
# (b) LOCAL GPU — start the stack with the local-llm profile and point at litellm:
#         REMOTE_LLM_URL=http://litellm:4000
#     (only valid when started with --profile local-llm; needs a GGUF in model/ollama/weights/)
#
# (c) No LLM — leave blank; entity extraction and canonicalize return 503 but
#     bronze→silver ingestion and retrieval still work.
REMOTE_LLM_URL=
REMOTE_LLM_KEY=

# ── model-service: embedding + reranker (local CPU by default) ──────────────────
# Multilingual defaults suit the Vietnamese corpus; override to benchmark others.
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Optional remote GPU proxy for embed + rerank (e.g. Colab embed/rerank notebook).
# When set, /embed and /rerank forward there; local models still load for health checks.
# Leave blank to use local CPU models (slower first request while weights download).
REMOTE_EMBED_URL=
REMOTE_RERANK_URL=
REMOTE_API_KEY=

# ── LightRAG tuning knobs (override without rebuilding kb-backend image) ─────────
QDRANT_PASS1_LIMIT=3
QDRANT_PASS2_LIMIT=2
RRF_TOP_N=20
RERANK_TOP_N=5
NEO4J_MAX_HOPS=1
NEO4J_MAX_NEIGHBOURS=5
DOC_NARROWING=1
DOC_PASS_TOP_M=3
DOC_PASS_CHUNK_LIMIT=5
QUERY_ALIAS_RESOLVE=1
TYPE_AWARE=1
