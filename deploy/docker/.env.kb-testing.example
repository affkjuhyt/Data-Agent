# Env for the kb-e2e stack (deploy/docker/docker-compose.kb-e2e.yml).
#
#   cp deploy/docker/.env.kb-testing.example deploy/docker/.env.kb-testing
#   docker compose -f deploy/docker/docker-compose.kb-e2e.yml --env-file deploy/docker/.env.kb-testing up -d --build
#
# The stack boots with this file empty — every value has a working default in the
# compose file. The one thing you almost always want to set is the LLM backend below;
# without it /generate returns 503 and gold-stage entity extraction fails silently.

# ── Shared-infra credentials ────────────────────────────────────────────────────
# Must match whatever the shared infra stack (base docker-compose.yml) was
# started with — these are the dev defaults.
KAFKA_ADMIN_PASSWORD=dev123
POSTGRES_PASSWORD=dev123

# ── LLM backend (model_service /generate → OpenAI-compatible endpoint) ──────────
# All LLM calls (gold entity extraction, conflict detection, LightRAG canonicalize)
# go through model_service. All inference runs on the GPU server (vLLM agent-main
# :8001 / agent-fast :8002 + TEI embed :8003 / rerank :8004), reached over the VPN.
#
# Two options (pick ONE):
#
# (a) DIRECT to the GPU server's vLLM fast tier (default):
#         REMOTE_LLM_URL=http://10.10.55.101:8002
#         REMOTE_LLM_MODEL=agent-fast
#
# (b) VIA litellm (when the base stack's litellm gateway is up and you want its
#     aliases/caching): REMOTE_LLM_URL=http://litellm:4000
REMOTE_LLM_URL=http://10.10.55.101:8002
REMOTE_LLM_KEY=
REMOTE_LLM_MODEL=agent-fast

# ── model_service: embedding + reranker (GPU server TEI) ────────────────────────
# model_service is a pure gateway — no local models. Leave these unset and
# /embed and /rerank return 503.
REMOTE_EMBED_URL=http://10.10.55.101:8003
REMOTE_RERANK_URL=http://10.10.55.101:8004
REMOTE_API_KEY=

# ── LightRAG tuning knobs (override without rebuilding kb-backend image) ─────────
QDRANT_PASS1_LIMIT=3
QDRANT_PASS2_LIMIT=2
RRF_TOP_N=20
RERANK_TOP_N=5
NEO4J_MAX_HOPS=1
NEO4J_MAX_NEIGHBOURS=5
DOC_NARROWING=1
DOC_PASS_TOP_M=3
DOC_PASS_CHUNK_LIMIT=5
QUERY_ALIAS_RESOLVE=1
TYPE_AWARE=1
