# Env for the KB-UI testing stack (infra/docker-compose.kb-ui-testing.yml).
#
#   Copy-Item infra/.env.kb-testing.example infra/.env.kb-testing
#   docker compose -f infra/docker-compose.kb-ui-testing.yml --env-file infra/.env.kb-testing up -d --build
#
# Every value here has a working default baked into the compose file, so the
# stack BOOTS even with this file empty. The one thing you almost always want to
# set is the LLM tunnel below — without it /generate returns 503 and the
# ingestion gold stage (entity extraction) and LightRAG canonicalize step fail.
# MinIO/Postgres/etc. credentials are hardcoded in the compose file (local-only
# testing) and are NOT read from here.

# ── LLM backend (OpenAI-compatible, e.g. Colab vLLM + cloudflared) ──────────────
# Three ways to provide the LLM (pick ONE):
#
# (a) LOCAL GPU — run the bundled llama service on your own NVIDIA card (e.g. RTX
#     3060). Put a Qwen GGUF at model/ollama/weights/model.gguf (see that folder's
#     model_weight.md), bring the stack up WITH the profile, and point the
#     model-service gateway at the in-stack litellm (OpenAI-compatible → llama):
#         docker compose -f docker-compose.kb-ui-testing.yml --profile local-llm \
#             --env-file .env.kb-testing up -d --build
#     then set (and leave VLLM_BASE_URL blank so the worker uses the llama backend):
#         REMOTE_LLM_URL=http://litellm:4000     # see REMOTE_LLM_URL below
#     The kb-backend reaches llama directly via LLAMA_BASE_URL=http://llama:11434
#     (already wired in compose); the worker auto-selects "llama" when VLLM is blank.
#
# (b) REMOTE vLLM (Colab + Cloudflare tunnel, see model/vllm/): set VLLM_BASE_URL —
#     it flips both kb-backend and the worker onto that OpenAI-compatible endpoint.
#
# (c) leave everything blank → no LLM (entity-extraction / canonicalize steps 503).
VLLM_BASE_URL=
VLLM_API_KEY=
# Worker LLM backend override: empty = auto (vllm if VLLM_BASE_URL set, else llama).
LLM_BACKEND=

# ── model-service: embedding + reranker (local CPU by default) ──────────────────
# Multilingual defaults suit the Vietnamese corpus; override to benchmark others.
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Optional GPU proxy: when set, /embed and /rerank forward to a remote server and
# the local models stay tiny (health only). Leave blank for local CPU compute.
REMOTE_EMBED_URL=
REMOTE_RERANK_URL=
REMOTE_API_KEY=
# model-service /generate forwards here (OpenAI-compatible). For the LOCAL GPU path
# (a) above, set this to the in-stack litellm: REMOTE_LLM_URL=http://litellm:4000
# (only valid when you started the stack with --profile local-llm).
REMOTE_LLM_URL=
REMOTE_LLM_KEY=

# ── LightRAG tuning knobs (override without rebuilding the kb-backend image) ────
QDRANT_PASS1_LIMIT=3
QDRANT_PASS2_LIMIT=2
RRF_TOP_N=20
RERANK_TOP_N=5
NEO4J_MAX_HOPS=1
NEO4J_MAX_NEIGHBOURS=5
DOC_NARROWING=1
DOC_PASS_TOP_M=3
DOC_PASS_CHUNK_LIMIT=5
QUERY_ALIAS_RESOLVE=1
TYPE_AWARE=1
