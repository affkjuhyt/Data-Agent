{
  "uid": "kb-ccu",
  "title": "KB — High CCU",
  "tags": ["kb", "ccu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "title": "Gateway RPS (by status)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(kb_gateway_requests_total[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2, "title": "Request latency p95 / p50 (ms)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(kb_gateway_request_duration_ms_bucket[1m])) by (le))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum(rate(kb_gateway_request_duration_ms_bucket[1m])) by (le))", "legendFormat": "p50" }
      ]
    },
    {
      "id": 3, "title": "In-flight requests", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 500 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kb_gateway_inflight" } ]
    },
    {
      "id": 4, "title": "Rejections /s (429 rate + 503 overload)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kb_gateway_requests_total{status=\"429\"}[1m]))", "legendFormat": "429 rate-limited" },
        { "refId": "B", "expr": "sum(rate(kb_gateway_requests_total{status=\"503\"}[1m]))", "legendFormat": "503 overload" }
      ]
    },
    {
      "id": 5, "title": "Embed cache hit-rate", "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.8 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kb_embed_cache_hit_rate" } ]
    },
    {
      "id": 6, "title": "Embed avg batch size", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "kb_embed_avg_batch" } ]
    },
    {
      "id": 7, "title": "Total RPS served", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(kb_gateway_requests_total[1m]))" } ]
    },
    {
      "id": 8, "title": "Compute device", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "fields": "", "calcs": ["lastNotNull"] }, "textMode": "name" },
      "targets": [ { "refId": "A", "expr": "kb_model_device", "legendFormat": "{{device}}" } ]
    }
  ]
}
