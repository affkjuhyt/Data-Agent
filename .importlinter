# Architecture contracts — enforces the SRS Dependency Rule (§3.5) where the
# current package layout allows it. Run: `lint-imports`.
#
# NOTE: only directories with an __init__.py are importable packages, so grimp
# sees libs.* and the services that have one (kb_backend, kb_*, platform_workers).
# workflow_runtime, auth_api, flow_builder, … have no __init__.py and cannot be
# analysed here. These contracts capture the rules that ARE true today and guard
# against regression. The full layered Dependency Rule contract (domain ←
# application ← adapters ← infrastructure) lands once those layers exist.

[importlinter]
root_packages =
    libs
    services
# Third-party packages become graph nodes, so a contract can forbid one
# (indicator-domains-are-pure forbids fastapi and the storage clients).
include_external_packages = True

[importlinter:contract:basemodel-is-independent]
name = basemodel (shared data models) must not depend on services
type = forbidden
source_modules =
    libs.basemodel
forbidden_modules =
    services

[importlinter:contract:shared-is-a-leaf]
name = libs.shared must not depend on concrete services
type = forbidden
source_modules =
    libs.shared
forbidden_modules =
    services.kb_backend
    libs.database_connector

# V2 (docs/v2/07 ADR-V2-38). libs.indicator is a pure calculation library:
# no I/O, no storage client, no ingestion, no service code.
[importlinter:contract:indicator-is-pure]
name = libs.indicator (V2 numeric core) must not depend on storage, ingestion or services
type = forbidden
source_modules =
    libs.indicator
forbidden_modules =
    services
    libs.database_connector
    libs.ingestion

# NOP-150. libs.contracts holds the wire shapes indicator-api, platform_workers,
# workflow_runtime and kb_backend share; a service import here would make every
# consumer import that service. libs.indicator (numeric core) is the only libs
# package it may use; libs.semantic's v1 DTOs are not the V2 contract.
[importlinter:contract:contracts-is-a-leaf]
name = libs.contracts (V2 wire contract) must not depend on services or other libs but libs.indicator
type = forbidden
source_modules =
    libs.contracts
forbidden_modules =
    services
    libs.shared
    libs.semantic
    libs.database_connector
    libs.ingestion
    libs.basemodel

# V2 data boundary (ADR-V2-38): V2 numbers never go through the v1 structured-KB
# path, and V2 business data never lands in MongoDB (ADR-V2-09, ADR-V2-34).
# Every new V2 package (services.indicator_api, the series_extractor /
# semantic_extractor / detector workers) is added to source_modules in the same
# commit that creates it. Topic names are strings import-linter cannot see; the
# source scan in tests/unit/kb_backend/test_v2_storage_boundary.py covers those
# (NOP-163, libs/shared/storage_ownership.py).
[importlinter:contract:v2-data-boundary]
name = V2 packages must not use the v1 structured-KB path or MongoDB
type = forbidden
source_modules =
    libs.indicator
    libs.contracts
    libs.shared.storage_ownership
    libs.ingestion.storage_boundary
    services.indicator_api
forbidden_modules =
    services.kb_backend.workers.structured_data
    libs.database_connector.mongo_connector
    libs.ingestion.silver
    libs.ingestion.gold

# NOP-162. indicator-api's domains/ is plain Python + Pydantic: routes live in
# api/, I/O in adapters/. A domain module that imports the web framework or a
# storage client breaks this contract and the CI step that runs it.
[importlinter:contract:indicator-domains-are-pure]
name = indicator_api.domains must not depend on FastAPI, storage clients, api/ or adapters/
type = forbidden
source_modules =
    services.indicator_api.domains
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    psycopg2
    psycopg
    asyncpg
    clickhouse_connect
    kafka
    aiokafka
    minio
    boto3
    redis
    pymongo
    motor
    qdrant_client
    services.indicator_api.api
    services.indicator_api.adapters
    libs.database_connector

# workflow_runtime is layered (api > application > infrastructure > domain): a lower
# layer never imports a higher one. application may use infrastructure directly (no
# ports/adapters yet: that is the remaining distance to a strict clean architecture).
# main.py and jobs/ are entrypoints and sit outside the layers.
[importlinter:contract:workflow-runtime-layers]
name = workflow_runtime layers: api > application > infrastructure > domain
type = layers
layers =
    services.workflow_runtime.api
    services.workflow_runtime.application
    services.workflow_runtime.infrastructure
    services.workflow_runtime.domain
