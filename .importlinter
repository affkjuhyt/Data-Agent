# Architecture contracts — enforces the SRS Dependency Rule (§3.5) where the
# current package layout allows it. Run: `lint-imports`.
#
# NOTE: only directories with an __init__.py are importable packages, so grimp
# sees libs.* and the services that have one (api, worker_*, crawler, platform_workers).
# workflow_runtime, auth_api, flow_builder, … have no __init__.py and cannot be
# analysed here. These contracts capture the rules that ARE true today and guard
# against regression. The full layered Dependency Rule contract (domain ←
# application ← adapters ← infrastructure) lands once those layers exist.

[importlinter]
root_packages =
    libs
    services
# Third-party packages become graph nodes, so a contract can forbid one
# (indicator-domains-are-pure forbids fastapi and the storage clients).
include_external_packages = True

[importlinter:contract:basemodel-is-independent]
name = basemodel (shared data models) must not depend on services
type = forbidden
source_modules =
    libs.basemodel
forbidden_modules =
    services

[importlinter:contract:shared-is-a-leaf]
name = libs.shared must not depend on concrete services
type = forbidden
source_modules =
    libs.shared
forbidden_modules =
    services
    libs.database_connector

# V2 (docs/v2/07 ADR-V2-38). libs.indicator is a pure calculation library:
# no I/O, no storage client, no ingestion, no service code.
[importlinter:contract:indicator-is-pure]
name = libs.indicator (V2 numeric core) must not depend on storage, ingestion or services
type = forbidden
source_modules =
    libs.indicator
forbidden_modules =
    services
    libs.database_connector

# NOP-150. libs.contracts holds the wire shapes platform_workers and worker_agent share; a service import here would make every
# consumer import that service. libs.indicator (numeric core) is the only libs
# package it may use; libs.semantic's v1 DTOs are not the V2 contract.
[importlinter:contract:contracts-is-a-leaf]
name = libs.contracts (V2 wire contract) must not depend on services or other libs but libs.indicator
type = forbidden
source_modules =
    libs.contracts
forbidden_modules =
    services
    libs.shared
    libs.semantic
    libs.database_connector
    libs.basemodel

# V2 data boundary (ADR-V2-38): V2 business data never lands in MongoDB (ADR-V2-09,
# ADR-V2-34). The v1 structured-KB path it also kept V2 numbers out of was deleted with
# kb-backend (KB-08). Every new V2 package is added to source_modules in the commit that
# creates it.
[importlinter:contract:v2-data-boundary]
name = V2 packages must not use MongoDB
type = forbidden
source_modules =
    libs.indicator
    libs.contracts
forbidden_modules =
    libs.database_connector.mongo_connector

# The `api` block (ADR-28, docs/v3/06-api-v1.md). The shared kernel
# serves every module and may not depend on one; the api is new code and takes
# nothing from the services it replaces. Module-to-module rules (only through a
# module's package __init__) are added with the second module.
[importlinter:contract:api-kernel-is-a-leaf]
name = services.api.kernel must not depend on api modules or the catalogue
type = forbidden
source_modules =
    services.api.kernel
forbidden_modules =
    services.api.modules
    services.api.catalogue
    services.api.app

[importlinter:contract:api-is-independent]
name = services.api must not import the legacy services
type = forbidden
source_modules =
    services.api
forbidden_modules =
    services.workflow_runtime
    services.auth_api
    services.platform_workers
    services.sandbox_executor
    services.model_service

# worker-agent (ADR-28): talks to the api only through the database and events, never by
# importing it, and takes nothing from the legacy runtime it replaces.
[importlinter:contract:worker-agent-is-independent]
name = services.worker_agent must not import the api or the legacy services
type = forbidden
source_modules =
    services.worker_agent
forbidden_modules =
    services.api
    services.workflow_runtime
    services.auth_api
    services.platform_workers
    services.sandbox_executor
    services.model_service

# crawler (ADR-28, KB-02): reaches the api and worker-agent only through acquire's tables and
# events, and takes nothing from the web-crawler it replaces.
[importlinter:contract:crawler-is-independent]
name = services.crawler must not import the api, worker-agent or the legacy services
type = forbidden
source_modules =
    services.crawler
forbidden_modules =
    services.api
    services.worker_agent
    services.platform_workers
    services.model_service
    libs.database_connector
    libs.basemodel
