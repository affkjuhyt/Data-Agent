{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    // TanStack Router's types need it (its createRouter refuses a config without it).
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // Without it tsc read everything under frontend/, the vite build in dist/ too (allowJs): after a
  // build, its 400 bundled files changed the types the sources got.
  "include": ["src", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
