// ---------- Nhóm theo domain ----------
TableGroup tenant_iam [color: #3b82f6] {
  "Tenants"
  "RolePermissions"
  "microsoft_sso_approvals"
  "api_keys"
  "ip_allowlists"
  "secrets_vault"
  "key_rotations"
  "compliance_settings"
  Note: 'Tenant, thành viên, phân quyền, SSO, API key, secret, compliance'
}

TableGroup audit_settings_outbox [color: #64748b] {
  "AuditLogs"
  "DataAccessLog"
  "OutboxEvents"
  "PlatformSettings"
  "platform_settings"
  Note: 'Audit, nhật ký truy cập dữ liệu, cấu hình nền tảng, outbox Kafka'
}

TableGroup knowledge_base [color: #16a34a] {
  "KBKnowledgeBase"
  "KBData"
  "KBLifecycleHistory"
  "KBTextBlock"
  "KBTextBlockVersion"
  "KBTextTable"
  "KBTable"
  "KBStructuredImportJob"
  "KBConflictBatch"
  "KBConflict"
  "KBEntityLookup"
  "KBFilterPolicy"
  "KBExtractionPolicy"
  Note: 'KBData là gốc tài liệu; chunk, version, bảng, import có cấu trúc, conflict toả ra từ đó'
}

TableGroup sources_crawl [color: #0d9488] {
  "KBSource"
  "KBSourceConfig"
  "KBSourceRun"
  "KBSourceCrawlQueue"
  Note: 'Source Registry: nguồn, cấu hình có version, lượt chạy, hàng đợi crawl'
}

TableGroup index_projections [color: #a855f7] {
  "KBModel"
  "KBQdrantConnection"
  "KBQdrantCollection"
  "KBNeo4jNode"
  "KBNeo4jRelationship"
  Note: 'Model embedding và metadata của các bản chiếu Qdrant / Neo4j'
}

TableGroup warehouse_semantic [color: #f59e0b] {
  "KBWarehouse"
  "KBWarehouseConfig"
  "SchemaCatalog"
  "SemanticMetric"
  "SemanticMetricVersion"
  "SemanticSynonym"
  Note: 'Kho dữ liệu vật lý, schema catalog và semantic layer (metric có version)'
}

TableGroup agent_authoring [color: #ef4444] {
  "Agents"
  "AgentVersions"
  "AgentKB"
  "AgentMCP"
  "Workflows"
  "WorkflowVersions"
  "MCP"
  "KBConnections"
  "Guardrails"
  "SystemPrompts"
  Note: 'Agent, version, workflow, MCP, guardrail, prompt'
}

TableGroup conversation_memory [color: #ec4899] {
  "Conversations"
  "Messages"
  "AgentTraces"
  "AgentMemories"
  "EpisodicMemory"
  "FutureMemory"
  "WorkflowMemory"
  "MemoryRetentionConfig"
  Note: 'Hội thoại, message, trace và các tầng memory của agent'
}
