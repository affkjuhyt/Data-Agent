Table "KBNeo4jNode" {
  "node_id" uuid [pk]
  "node_name" varchar(512) [not null]
  "node_description" text
  "inserted_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "tenant_id" uuid [note: 'tham chiếu logic, không có FK → Tenants.id']
  "knowledge_base" varchar(512) [note: 'str(KBData.knowledge_base_id), or the literal \'General Knowledge Base\' when the document has none. Part of the node id hash; no FK.']

  indexes {
    "inserted_at" [name: 'idx_kbneo4jnode_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "knowledge_base") [name: 'idx_kbneo4jnode_tenant_kb']
    "created_at" [name: 'ix_KBNeo4jNode_created_at']
  }

  Note: 'Postgres mirror of the Neo4j entity nodes, written by GraphStore alongside Neo4j; used for provenance and as the UI fallback when Neo4j is down.'
}

Table "KBNeo4jRelationship" {
  "from_node" uuid
  "to_node" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "block_id" uuid [note: 'tham chiếu logic, không có FK → KBTextBlock.block_id']
  "data_id" uuid [note: 'tham chiếu logic, không có FK → KBData.data_id']
  "tenant_id" uuid [note: 'tham chiếu logic, không có FK → Tenants.id']
  "knowledge_base" varchar(512) [note: 'str(KBData.knowledge_base_id), or the literal \'General Knowledge Base\' when the document has none; no FK.']

  indexes {
    ("from_node", "to_node", "block_id") [pk]
    "block_id" [name: 'idx_kbneo4jrelationship_block']
    "data_id" [name: 'idx_kbneo4jrelationship_data']
    "inserted_at" [name: 'idx_kbneo4jrelationship_inserted_at_desc', note: 'inserted_at DESC']
    ("from_node", "to_node") [name: 'idx_kbneo4jrelationship_pair']
    ("tenant_id", "knowledge_base") [name: 'idx_kbneo4jrelationship_tenkb']
    "created_at" [name: 'ix_KBNeo4jRelationship_created_at']
  }

  Note: 'Postgres mirror of the Neo4j RELATES edges, one row per (from_node, to_node, block_id) so each edge keeps the chunk it came from.'
}

Table "KBQdrantCollection" {
  "collection_id" uuid [pk]
  "connection_id" uuid [not null]
  "collection_name" varchar(255) [not null]
  "is_active" bool [not null, default: false]
  "embedding_model_id" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbqdrantcollection_inserted_at_desc', note: 'inserted_at DESC']
    "connection_id" [name: 'ix_KBQdrantCollection_connection_id']
    "created_at" [name: 'ix_KBQdrantCollection_created_at']
  }

  Note: '''
Ties a tenant's Qdrant collections to their embedding model. Dimension, distance and point count are read live from Qdrant.
RLS bật (tenant_id = app.tenant_id)
'''
}

Table "KBQdrantConnection" {
  "connection_id" uuid [pk]
  "tenant_id" uuid [not null]
  "is_active" bool [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "tenant_id" [name: 'idx_kbqdrantconn_tenant_active', note: 'WHERE (is_active = true)']
    "inserted_at" [name: 'idx_kbqdrantconnection_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_KBQdrantConnection_created_at']
    "tenant_id" [name: 'ix_KBQdrantConnection_tenant_id']
  }

  Note: '''
Ties Qdrant collections to a tenant. Holds no URL: the Qdrant endpoint comes from QDRANT_URL.
RLS bật (tenant_id = app.tenant_id)
'''
}

Table "KBSource" {
  "source_id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "role_id" uuid [not null]
  "connector_type" varchar(32) [not null]
  "title" varchar(512) [not null]
  "publisher" varchar(255)
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbsource_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_kbsource_tenant']
    ("tenant_id", "title") [unique, name: 'uq_kbsource_tenant_title_live', note: 'WHERE (is_deleted = false)']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBSourceConfig" {
  "config_id" uuid [pk, default: `gen_random_uuid()`]
  "source_id" uuid [not null]
  "version_number" int [not null]
  "is_active" bool [not null, default: false]
  "config" jsonb
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "row_version" uuid [not null, default: `gen_random_uuid()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    "source_id" [unique, name: 'idx_kbsourceconfig_source_active', note: 'WHERE (is_active = true)']
    ("source_id", "version_number") [name: 'idx_kbsourceconfig_source_version']
  }
}

Table "KBSourceCrawlQueue" {
  "queue_id" uuid [pk, default: `gen_random_uuid()`]
  "source_id" uuid [not null]
  "tenant_id" uuid [not null]
  "url" text [not null]
  "depth" int [not null, default: 0]
  "discovered_from" text
  "status" varchar(16) [not null, default: 'pending']
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbsourcecrawlqueue_inserted_at_desc', note: 'inserted_at DESC']
    ("source_id", "url") [unique, name: 'idx_kbsourcecrawlqueue_source_url']
    ("tenant_id", "status") [name: 'idx_kbsourcecrawlqueue_tenant_status']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBSourceRun" {
  "run_id" uuid [pk, default: `gen_random_uuid()`]
  "source_id" uuid [not null]
  "status" varchar(16) [not null]
  "trigger" varchar(16) [not null]
  "data_ids" jsonb [note: 'JSON array of the KBData.data_id values this run produced; no FK. — tham chiếu logic, không có FK → KBData.data_id (mảng JSON)']
  "error" text
  "quality_metrics" jsonb
  "started_at" timestamptz [not null, default: `now()`]
  "finished_at" timestamptz
  "inserted_at" timestamptz [not null, default: `now()`]
  "retry_count" int [not null, default: 0]
  "next_retry_at" timestamptz

  indexes {
    ("source_id", "started_at") [name: 'idx_kbsourcerun_source_started_desc', note: 'started_at DESC']
  }
}

Table "KBStructuredImportJob" {
  "job_id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null, note: 'KBData.data_id of the document being imported.']
  "status" varchar(32) [not null, default: 'proposing']
  "llm_proposed_schema" jsonb
  "human_edited_schema" jsonb
  "sample_rows" jsonb
  "created_table_name" varchar(255)
  "error_message" text
  "created_by" varchar(255)
  "reviewed_by" varchar(255)
  "reviewed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    ("owner_id", "created_at") [name: 'idx_kbstructuredimportjob_owner_created', note: 'created_at DESC']
  }
}

Table "KBTable" {
  "table_id" uuid [pk]
  "owner_id" uuid [not null, note: 'KBData.data_id of the structured-table document.']
  "table_name" varchar(255) [not null]
  "description" text
  "schema" jsonb
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbtable_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_KBTable_created_at']
    "owner_id" [name: 'ix_KBTable_owner_id']
    "table_name" [name: 'ix_KBTable_table_name']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBTextBlock" {
  "block_id" uuid [pk]
  "owner_id" uuid [not null, note: 'KBData.data_id of the document this chunk belongs to.']
  "block_index" int [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbtextblock_inserted_at_desc', note: 'inserted_at DESC']
    ("owner_id", "block_id") [name: 'idx_kbtextblock_owner_block']
    "created_at" [name: 'ix_KBTextBlock_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBTextBlockVersion" {
  "version_id" uuid [pk]
  "block_id" uuid [not null]
  "version_number" int [not null]
  "content" text
  "created_by" varchar(255)
  "table_involved" bool
  "payload" jsonb [note: 'Chunk metadata also held in the Qdrant payload (summary, entities, embedding_model_id, knowledge_base, region); only entities is read back from here.']
  "is_active" bool
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    ("block_id", "version_number") [name: 'idx_kbtextblockversion_block_version', note: 'WHERE (is_active = true)']
    `to_tsvector('simple'::regconfig, content)` [name: 'idx_kbtextblockversion_content_fts', note: 'USING gin']
    "inserted_at" [name: 'idx_kbtextblockversion_inserted_at_desc', note: 'inserted_at DESC']
    "block_id" [name: 'ix_KBTextBlockVersion_block_id']
    "created_at" [name: 'ix_KBTextBlockVersion_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBTextTable" {
  "version_id" uuid [pk]
  "table_name" varchar(255) [not null]
  "description" text
  "data" jsonb
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "row_version" uuid [not null, default: `gen_random_uuid()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbtexttable_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_KBTextTable_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBWarehouse" {
  "warehouse_id" uuid [pk]
  "service" varchar(255) [not null, note: 'Warehouse engine as entered (Snowflake, Databricks, Postgres; case varies). The schema crawler normalises it.']
  "description" text
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "tenant_id" uuid

  indexes {
    "inserted_at" [name: 'idx_kbwarehouse_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_kbwarehouse_tenant']
    "created_at" [name: 'ix_KBWarehouse_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBWarehouseConfig" {
  "config_id" uuid [pk]
  "warehouse_id" uuid [not null]
  "version_number" int [not null]
  "is_active" bool [not null, default: false]
  "config" jsonb
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "row_version" uuid [not null, default: `gen_random_uuid()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbwarehouseconfig_inserted_at_desc', note: 'inserted_at DESC']
    "warehouse_id" [unique, name: 'idx_kbwarehouseconfig_wh_active', note: 'WHERE (is_active = true)']
    ("warehouse_id", "version_number") [name: 'idx_kbwarehouseconfig_wh_version']
    "created_at" [name: 'ix_KBWarehouseConfig_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "MCP" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "name" varchar(255) [not null]
  "endpoint_url" text [not null]
  "api_key_ref" varchar(255) [note: 'secrets_vault.id of an MCP_TOKEN secret; config_loader reads the bearer token from OpenBao. Never the token itself.']
  "status" varchar(20) [not null]
  "capabilities" jsonb
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_mcp_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_mcp_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "MemoryRetentionConfig" {
  "tenant_id" uuid
  "domain" varchar(64)
  "retention_days" int
  "max_records_per_user" int [not null, default: 500]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    ("tenant_id", "domain") [pk]
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "Messages" {
  "id" uuid [pk]
  "conversation_id" uuid [not null]
  "role" varchar(20) [not null]
  "content" jsonb [note: '{"text": <message text>}.']
  "metadata" jsonb [note: 'Assistant turn context: agent_version_id, language, intent, analysis_type, slots, clarifications, responder_model, pending_options, pending_approval, citations.']
  "tokens_used" int [note: 'Always 0 so far: no caller passes a token count.']
  "latency_ms" int
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("conversation_id", "created_at") [name: 'idx_messages_conversation_created']
    "inserted_at" [name: 'idx_messages_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_Messages_created_at']
  }
}

Table "OutboxEvents" {
  "id" bigint [pk, increment]
  "producer" varchar(50) [not null, note: 'Service that wrote the event (workflow-runtime, kb-backend, kb-promote-silver, kb-promote-gold, web-crawler); that service\'s relay publishes it.']
  "topic" varchar(200) [not null]
  "event_key" varchar(200)
  "payload" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "published_at" timestamptz
  "attempts" int [not null, default: 0]
  "last_error" text
  "dead_at" timestamptz

  indexes {
    ("producer", "id") [name: 'idx_outboxevents_pending', note: 'WHERE ((published_at IS NULL) AND (dead_at IS NULL))']
  }
}

Table "PlatformSettings" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "key" varchar(100) [not null]
  "value" jsonb [not null]
  "updated_by" varchar(255)
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    ("tenant_id", "key") [unique, name: 'uq_platform_settings_tenant_key']
  }

  Note: '''
Per-tenant settings, key -> jsonb (org_profile, schedules, delivery_channels, delivery_outbox, agent_templates). The platform-wide flags are in platform_settings.
RLS bật (tenant_id = app.tenant_id)
'''
}

Table "RolePermissions" {
  "id" uuid [pk]
  "role_id" varchar(50) [not null, note: 'Role name: PLATFORM_ADMIN, AI_ENGINEER, EXECUTIVE or BUSINESS_OPERATOR.']
  "resource" varchar(100) [not null]
  "action" varchar(50) [not null]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("role_id", "resource", "action") [unique, name: 'uq_role_permissions']
    "inserted_at" [name: 'idx_role_permissions_inserted_at_desc', note: 'inserted_at DESC']
  }

  Note: 'Permission grants per role (action is a name from kb_backend\'s permission CATALOG), plus one anchor row per role with resource \'_role_anchor\': KBData.role_id and KBSource.role_id point at those anchors.'
}

Table "SchemaCatalog" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "warehouse_id" uuid [not null]
  "schema_name" varchar(128) [not null]
  "table_name" varchar(128) [not null]
  "columns" jsonb [not null]
  "row_count" bigint
  "last_altered" timestamptz
  "text_description" text [not null]
  "join_hints" jsonb
  "schema_hash" varchar(32) [not null]
  "qdrant_point_id" varchar(128)
  "last_crawled_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "owner" varchar(255)
  "classification" varchar(32)
  "upstream" jsonb
  "freshness_column" varchar(128)
  "data_as_of" timestamptz
  "freshness_checked_at" timestamptz
  "freshness_sla_seconds" int

  indexes {
    ("tenant_id", "warehouse_id", "schema_name", "table_name") [unique, name: 'uq_schemacatalog_table']
    ("tenant_id", "data_as_of") [name: 'idx_schemacatalog_freshness', note: 'WHERE (freshness_sla_seconds IS NOT NULL)']
    ("tenant_id", "warehouse_id") [name: 'idx_schemacatalog_lookup']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "SemanticMetric" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "metric_key" varchar(128) [not null]
  "name" varchar(256) [not null]
  "description" text [not null, default: '']
  "owner" varchar(256) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    ("tenant_id", "metric_key") [unique, name: 'uq_semantic_metric_key']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "SemanticMetricVersion" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "metric_id" uuid [not null]
  "version" int [not null]
  "status" varchar(16) [not null, default: 'draft']
  "source_table" varchar(256) [not null]
  "aggregation" varchar(32) [not null]
  "expression" varchar(256) [not null]
  "time_column" varchar(128)
  "default_grain" varchar(16) [not null, default: 'none']
  "unit" varchar(64) [not null, default: '']
  "dimensions" jsonb [not null, default: '[]']
  "default_filters" jsonb [not null, default: '[]']
  "approved_by" varchar(256)
  "approved_at" timestamptz
  "change_note" text [not null, default: '']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    ("metric_id", "version") [unique, name: 'uq_semantic_metric_version']
    ("tenant_id", "metric_id", "status") [name: 'idx_semantic_version_lookup']
    "metric_id" [unique, name: 'uq_semantic_one_approved_version', note: 'WHERE ((status)::text = \'approved\'::text)']
  }

  Note: '''
RLS bật (tenant_id = app.tenant_id)
ck_semantic_version_status: CHECK status IN ('draft', 'approved', 'deprecated')
ck_semantic_version_grain: CHECK default_grain IN ('none', 'day', 'week', 'month', 'quarter', 'year')
ck_semantic_version_agg: CHECK aggregation IN ('sum', 'count', 'count_distinct', 'avg', 'min', 'max')
ck_semantic_version_grain_needs_time: CHECK (((default_grain = 'none') OR (time_column IS NOT NULL)))
'''
}

Table "SemanticSynonym" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "metric_id" uuid [not null]
  "term" varchar(256) [not null]
  "term_normalized" varchar(256) [not null]
  "locale" varchar(16) [not null, default: 'vi']
  "is_active" bool [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    ("tenant_id", "term_normalized") [unique, name: 'uq_semantic_synonym_term']
    ("tenant_id", "metric_id") [name: 'idx_semantic_synonym_metric']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "SystemPrompts" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "name" varchar(255) [not null]
  "content" text [not null]
  "version" int [not null]
  "is_active" bool [not null, default: true]
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_systemprompts_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_systemprompts_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "Tenants" {
  "id" uuid [pk]
  "name" varchar(255) [not null]
  "slug" varchar(100) [not null, unique]
  "is_active" bool [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_tenants_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_Tenants_created_at']
  }
}

Table "WorkflowMemory" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "agent_id" uuid [not null]
  "task_type" varchar(64) [not null]
  "task_description" text [not null]
  "param_snapshot" jsonb [not null]
  "outcome" varchar(16) [not null]
  "duration_ms" int
  "qdrant_point_id" varchar(128)
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    "created_at" [name: 'idx_workflowmemory_created_at_desc', note: 'created_at DESC']
    ("tenant_id", "agent_id", "task_type") [name: 'idx_workflowmemory_task_type']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "WorkflowVersions" {
  "id" uuid [pk]
  "workflow_id" uuid [not null]
  "version" int [not null]
  "status" varchar(20) [not null]
  "changelog" varchar(512)
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "published_at" timestamptz
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("workflow_id", "version") [unique, name: 'uq_workflow_versions_workflow_version']
    "inserted_at" [name: 'idx_workflowversions_inserted_at_desc', note: 'inserted_at DESC']
    ("workflow_id", "status") [name: 'idx_workflowversions_workflow_status']
    "workflow_id" [unique, name: 'uq_workflowversions_one_draft', note: 'WHERE ((status)::text = \'draft\'::text)']
    "workflow_id" [unique, name: 'uq_workflowversions_one_published', note: 'WHERE ((status)::text = \'published\'::text)']
  }
}

Table "Workflows" {
  "id" uuid [pk]
  "agent_id" uuid [not null]
  "name" varchar(255) [not null]
  "description" varchar(512)
  "is_active" bool [not null, default: true]
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "agent_id" [name: 'idx_workflows_agent']
    "inserted_at" [name: 'idx_workflows_inserted_at_desc', note: 'inserted_at DESC']
  }
}

Table "api_keys" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "created_by" varchar(255) [not null]
  "name" varchar(255) [not null]
  "key_hash" text [not null, note: 'bcrypt hash of the issued key. auth_api /internal/api-keys/verify checks presented keys against it, found by key_prefix.']
  "key_prefix" varchar(64) [not null]
  "scope" varchar(32) [not null]
  "last_used_at" timestamptz
  "expires_at" timestamptz
  "revoked_at" timestamptz
  "rotated_from" uuid [note: 'tham chiếu logic, không có FK → api_keys.id']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    "tenant_id" [name: 'ix_api_keys_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "compliance_settings" {
  "tenant_id" varchar(64) [pk, note: 'Tenants.id as text; no FK. — tham chiếu logic, không có FK → Tenants.id (varchar, khác kiểu uuid)']
  "pii_masking" bool [not null, default: false]
  "pii_types" text [not null, default: 'EMAIL,PHONE,CCCD,CMND,CREDIT_CARD,IP', note: 'Comma-separated PII types masked when pii_masking is on, e.g. EMAIL,PHONE,CCCD,CMND,CREDIT_CARD,IP.']
  "residency_region" varchar(32) [not null, default: 'Asia-SE1']
  "residency_standards" text [not null, default: 'GDPR']
  "retention_days" int [not null, default: 365]
  "retention_lock" bool [not null, default: false]
  "zero_trust" bool [not null, default: false]
  "audit_residency" bool [not null, default: false]
  "updated_at" timestamptz [default: `now()`]
  "updated_by" varchar(128) [default: '']
  "vault_panic_mode" bool [not null, default: false, note: 'Panic mode for this tenant: its secrets were revoked and its secret routes answer 503 until a platform-admin turns it off.']
}

Table "ip_allowlists" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "cidr" varchar(64) [not null]
  "label" varchar(255)
  "is_active" bool [not null, default: true]
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    ("tenant_id", "cidr") [unique, name: 'uq_ip_allowlists_tenant_cidr']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "key_rotations" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "secret_id" uuid [not null, note: 'secrets_vault row affected: the new row for MANUAL, the same row for SCHEDULED, PANIC and REVEAL.']
  "triggered_by" varchar(32) [not null, note: 'SCHEDULED, MANUAL, PANIC or REVEAL. A REVEAL row records a secret being shown, not a rotation.']
  "actor_id" varchar(255)
  "old_version" int
  "new_version" int
  "status" varchar(32)
  "error" text
  "access_reason" text
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    "secret_id" [name: 'ix_key_rotations_secret']
  }

  Note: 'key_rotations_triggered_by_check: CHECK triggered_by IN (\'SCHEDULED\', \'MANUAL\', \'PANIC\', \'REVEAL\')'
}

Table "microsoft_sso_approvals" {
  "id" text [pk, default: `(gen_random_uuid())::text`]
  "keycloak_user_id" text [not null, unique]
  "email" text [not null]
  "display_name" text [not null, default: '']
  "status" text [not null, default: 'pending']
  "requested_role" text
  "requested_tenant_id" text [note: 'tham chiếu logic, không có FK → Tenants.id (text)']
  "reviewed_by" text
  "reviewed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    ("status", "created_at") [name: 'idx_ms_approvals_status_created']
  }

  Note: 'ck_ms_approvals_status: CHECK status IN (\'pending\', \'approved\', \'rejected\')'
}

Table "platform_settings" {
  "key" varchar(100) [pk]
  "value" text [not null]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: 'Platform-wide flags, key -> text (ip_allowlist_mode, vault_auto_rotation, vault_pii_access_log). Per-tenant settings are in PlatformSettings; panic mode is per tenant in compliance_settings.'
}

Table "secrets_vault" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "key_name" varchar(255) [not null]
  "key_type" varchar(64) [not null]
  "algorithm" varchar(64)
  "realm" varchar(64) [note: 'Free-text grouping label shown in the UI (e.g. FINANCE-INFRA); unrelated to Keycloak realms.']
  "version" int [not null, default: 1]
  "is_active" bool [not null, default: true]
  "rotation_due_at" timestamptz
  "last_rotated_at" timestamptz
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    "tenant_id" [name: 'ix_secrets_vault_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

