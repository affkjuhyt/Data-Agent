  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "pipeline_metadata" jsonb

  indexes {
    "inserted_at" [name: 'idx_kblifecyclehistory_inserted_at_desc', note: 'inserted_at DESC']
    "created_at" [name: 'ix_KBLifecycleHistory_created_at']
    "data_id" [name: 'ix_KBLifecycleHistory_data_id']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBModel" {
  "model_id" uuid [pk]
  "model_name" varchar(255) [not null]
  "task_type" varchar(64) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbmodel_inserted_at_desc', note: 'inserted_at DESC']
