// Data Agent — cấu trúc Postgres `dataagent` (schema public) hiện tại.
// Mở https://dbdiagram.io/d → dán toàn bộ file này vào ô bên trái.
//
// Sinh tự động từ catalog Postgres sau `alembic upgrade head` trên DB trống
// (head = 9f3c7a1e5d2b), không vẽ tay: bảng, cột, kiểu, default, PK/unique,
// FK (Ref) và index là đúng như DB. Không sửa tay — sinh lại khi có migration mới.
// Note của bảng/cột gồm COMMENT trong DB (nghĩa của cột) và những gì DBML không
// biểu diễn được (CHECK, partial index, GIN, RLS, tham chiếu không có FK).

Project data_agent {
  database_type: 'PostgreSQL'
  Note: '''
**Data Agent — Postgres `dataagent`, schema `public`** (alembic head `9f3c7a1e5d2b`)

- 59 bảng, 69 FK, 36 bảng bật RLS (theo `tenant_id` + `app.tenant_id`).
- Schema V2 `registry`, `ingest`, `knowledge`, `governance`, `alert` đã tạo (migration `5b7d9f1a3c6e`) nhưng **chưa có bảng** — xem `docs/v2/10-database-design.md`, `docs/v2/14-input-data-db.md`.
- Không có trong sơ đồ: `kb_structured` (bảng tạo lúc chạy khi import dữ liệu có cấu trúc), `langgraph` (checkpointer tự tạo), `keycloak`, `kong`.
- Ngoài Postgres: MinIO (raw), Qdrant/Neo4j (bản chiếu dựng lại được), MongoDB, Redis, ClickHouse.
'''
}

Table "AgentKB" {
  "version_id" uuid
  "kb_connection_id" uuid
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("version_id", "kb_connection_id") [pk]
  }
}

Table "AgentMCP" {
  "version_id" uuid
  "mcp_id" uuid
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("version_id", "mcp_id") [pk]
  }
}

Table "AgentMemories" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "agent_id" uuid [not null]
  "scope" varchar(20) [not null]
  "user_ref" varchar(255)
  "memory_type" varchar(20) [not null]
  "content" text
  "embedding_ref" varchar(255)
  "importance" float8
  "expires_at" timestamptz
  "deleted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "domain" varchar(64) [not null, default: 'general']
  "fact_key" varchar(128)

  indexes {
    ("tenant_id", "agent_id", "scope", "user_ref", "domain", "fact_key") [unique, name: 'uq_agentmemories_fact']
    ("agent_id", "scope") [name: 'idx_agentmemories_agent_scope']
    ("agent_id", "user_ref") [name: 'idx_agentmemories_agent_user_ref']
    "deleted_at" [name: 'idx_agentmemories_deleted_at', note: 'WHERE (deleted_at IS NULL)']
    "inserted_at" [name: 'idx_agentmemories_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "agent_id", "user_ref", "domain") [name: 'idx_agentmemories_user_domain']
  }

  Note: '''
RLS bật (tenant_id = app.tenant_id)
uq_agentmemories_fact: UNIQUE NULLS NOT DISTINCT (tenant_id, agent_id, scope, user_ref, domain, fact_key)
'''
}

Table "AgentTraces" {
  "id" uuid [pk]
  "message_id" uuid [not null]
  "trace_index" smallint [not null]
  "tool_name" varchar(255) [not null, note: 'LangGraph node name, tool/<name> for a tool call, or responder.']
  "input" jsonb
  "output" jsonb
  "status" varchar(20) [not null]
  "latency_ms" int
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    ("message_id", "trace_index") [unique, name: 'uq_agent_traces_message_index']
    "inserted_at" [name: 'idx_agenttraces_inserted_at_desc', note: 'inserted_at DESC']
  }
}

Table "AgentVersions" {
  "id" uuid [pk]
  "agent_id" uuid [not null]
  "version" int [not null]
  "status" varchar(20) [not null]
  "workflow_version_id" uuid
  "llm_config" jsonb
  "system_prompt_id" uuid
  "memory_enabled" bool [not null, default: false]
  "changelog" varchar(512)
  "created_by" varchar(255)
  "published_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "responder_model" varchar(255) [note: 'LiteLLM model alias (as GET /api/llm-providers lists it, e.g. responder) the agent answers with; NULL = the deployment default.']

  indexes {
    ("agent_id", "version") [unique, name: 'uq_agent_versions_agent_version']
    ("agent_id", "status") [name: 'idx_agentversions_agent_status']
    "inserted_at" [name: 'idx_agentversions_inserted_at_desc', note: 'inserted_at DESC']
  }
}

Table "Agents" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "name" varchar(255) [not null]
  "description" varchar(512)
  "published_version_id" uuid [note: 'AgentVersions.id currently served. The ORM declares this FK but no migration created it. — tham chiếu logic, không có FK → AgentVersions.id']
  "draft_version_id" uuid [note: 'AgentVersions.id of the editable draft; draft updates find it by AgentVersions.status instead. The ORM declares this FK but no migration created it. — tham chiếu logic, không có FK → AgentVersions.id']
  "is_active" bool [not null, default: true]
  "deleted_at" timestamptz
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_agents_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_agents_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "AuditLogs" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "actor" varchar(255) [not null]
  "actor_type" varchar(20) [not null]
  "action" varchar(100) [not null]
  "resource_type" varchar(100)
  "resource_id" varchar(255)
  "status" varchar(10) [not null]
  "metadata" jsonb
  "ip_address" varchar(50)
  "source_event_id" text
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_audit_logs_inserted_at_desc', note: 'inserted_at DESC']
    "source_event_id" [name: 'idx_audit_logs_source_event', note: 'WHERE (source_event_id IS NOT NULL)']
    ("tenant_id", "created_at") [name: 'idx_audit_logs_tenant']
    "created_at" [name: 'ix_AuditLogs_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "Conversations" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "user_ref" varchar(255)
  "channel" varchar(20)
  "status" varchar(20) [not null, note: 'Set to active on creation and never updated.']
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_conversations_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "user_ref") [name: 'idx_conversations_tenant_user_ref']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "DataAccessLog" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "event_id" uuid [not null, unique]
  "tenant_id" uuid [not null]
  "user_id" varchar(255) [not null]
  "user_roles" "text[]" [not null, default: `'{}'::text[]`]
  "auth_source" varchar(64) [not null, default: '']
  "action" varchar(32) [not null]
  "decision" varchar(16) [not null]
  "target" varchar(256) [not null, default: '']
  "target_objects" "text[]" [not null, default: `'{}'::text[]`]
  "statement_redacted" text [not null, default: '']
  "statement_sha256" varchar(64) [not null, default: '']
  "metric_ref" varchar(160) [not null, default: '', note: 'Semantic metric the query used, as metric_key@version (e.g. revenue_net@3); empty when none.']
  "row_count" bigint
  "latency_ms" int
  "reason" text [not null, default: '']
  "session_id" varchar(64) [not null, default: '']
  "agent_id" varchar(64) [not null, default: '']
  "metadata" jsonb
  "occurred_at" timestamptz [not null]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "target_objects" [name: 'idx_data_access_objects', note: 'USING gin']
    "statement_sha256" [name: 'idx_data_access_statement']
    ("tenant_id", "occurred_at") [name: 'idx_data_access_tenant_time', note: 'occurred_at DESC']
    ("tenant_id", "user_id", "occurred_at") [name: 'idx_data_access_user_time', note: 'occurred_at DESC']
  }

  Note: '''
RLS bật (tenant_id = app.tenant_id)
ck_data_access_decision: CHECK decision IN ('allow', 'deny', 'error')
ck_data_access_action: CHECK action IN ('sql_query', 'schema_introspect', 'kb_retrieve', 'code_exec')
'''
}

Table "EpisodicMemory" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "agent_id" uuid [not null]
  "user_ref" varchar(255)
  "domain" varchar(64) [not null, default: 'general']
  "content" text [not null]
  "importance_score" float8 [not null, default: '0.5']
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz
  "status" varchar(16) [not null, default: 'active']

  indexes {
    "expires_at" [name: 'idx_episodicmemory_expires', note: 'WHERE (expires_at IS NOT NULL)']
    "tenant_id" [name: 'idx_episodicmemory_tenant']
    ("user_ref", "created_at") [name: 'idx_episodicmemory_user_time', note: 'created_at DESC']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "FutureMemory" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "agent_id" uuid [not null]
  "user_ref" varchar(255)
  "content" text [not null]
  "execution_time" timestamptz [not null]
  "recurrence" varchar(64)
  "status" varchar(16) [not null, default: 'pending']
  "executed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    "tenant_id" [name: 'idx_futurememory_tenant']
    ("user_ref", "status", "execution_time") [name: 'idx_futurememory_user_status_time']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "Guardrails" {
  "id" uuid [pk]
  "name" varchar(255) [not null]
  "type" varchar(50) [not null]
  "conditions" jsonb [not null]
  "action" varchar(20) [not null]
  "priority" int [not null]
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "guardrail_model" varchar(255) [note: 'LiteLLM model alias the guardrail LLM check calls; NULL = guardrail.']

  indexes {
    "inserted_at" [name: 'idx_guardrails_inserted_at_desc', note: 'inserted_at DESC']
  }
}

Table "KBConflict" {
  "conflict_id" uuid [pk]
  "tenant_id" uuid
  "conflict_type" varchar(64) [not null]
  "severity" varchar(16) [not null]
  "batch_id" uuid
  "status" varchar(32) [not null]
  "detailed_explanation" text
  "resolution_instruction" text
  "resolution_method" varchar(20)
  "resolved_by" varchar(255)
  "resolved_at" timestamptz
  "detected_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "data_id" uuid
  "from_recheck" bool [not null, default: false]

  indexes {
    "data_id" [name: 'idx_kbconflict_data_id']
    "inserted_at" [name: 'idx_kbconflict_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "status", "severity") [name: 'idx_kbconflict_tenant_status_severity']
    "batch_id" [name: 'ix_KBConflict_batch_id']
    "created_at" [name: 'ix_KBConflict_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBConflictBatch" {
  "batch_id" uuid [pk]
  "tenant_id" uuid
  "batch_title" varchar(512) [not null]
  "status" varchar(32) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "existing_block_id" uuid [note: 'tham chiếu logic, không có FK → KBTextBlock.block_id']

  indexes {
    "inserted_at" [name: 'idx_kbconflictbatch_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "existing_block_id") [unique, name: 'idx_kbconflictbatch_open_block', note: 'WHERE (((status)::text <> \'resolved\'::text) AND (is_deleted = false))']
    "created_at" [name: 'ix_KBConflictBatch_created_at']
    "tenant_id" [name: 'ix_KBConflictBatch_tenant_id']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBConnections" {
  "id" uuid [pk]
  "tenant_id" uuid [not null]
  "name" varchar(255) [not null]
  "endpoint_url" text [not null]
  "api_key_ref" varchar(255)
  "status" varchar(20) [not null]
  "last_synced_at" timestamptz
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbconnections_inserted_at_desc', note: 'inserted_at DESC']
    "tenant_id" [name: 'idx_kbconnections_tenant']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBData" {
  "data_id" uuid [pk]
  "tenant_id" uuid [not null]
  "role_id" uuid [not null, note: 'Lowest role that may see the document: one of the RolePermissions anchor rows. A viewer sees documents of their own role and every lower one (PLATFORM_ADMIN > AI_ENGINEER > EXECUTIVE > BUSINESS_OPERATOR).']
  "name" varchar(512) [not null]
  "extension" varchar(32) [not null]
  "language" varchar(32) [not null]
  "source_type" varchar(32) [not null]
  "added_by" varchar(255) [not null, note: 'Display name of the uploader, not a user id.']
  "abstract" text [not null, note: 'Short description. The upload UI sends the document name here; web crawls write an empty string.']
  "metadata" jsonb [not null]
  "current_tier" varchar(16) [not null, note: 'Furthest medallion tier reached: bronze, silver or gold. Same as the latest KBLifecycleHistory.to_tier.']
  "path" varchar(1024) [note: 'MinIO object key of the uploaded file. NULL for web-crawled documents.']
  "added_on" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "knowledge_base_id" uuid
  "ingestion_mode" varchar(32) [not null, default: 'document', note: 'document (chunked and embedded) or structured_table (rows imported into kb_structured).']
  "row_version" uuid [not null, default: `gen_random_uuid()`, note: 'Optimistic-lock token, regenerated on every write; no writer compares it yet.']
  "updated_at" timestamptz [not null, default: `now()`]
  "content_hash" varchar(64)
  "purpose" varchar(16) [not null, default: 'production']

  indexes {
    "inserted_at" [name: 'idx_kbdata_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "current_tier", "inserted_at", "data_id") [name: 'idx_kbdata_keyset']
    ("tenant_id", "inserted_at", "data_id") [name: 'idx_kbdata_keyset_all']
    "knowledge_base_id" [name: 'idx_kbdata_knowledge_base_id']
    ("tenant_id", "content_hash") [name: 'idx_kbdata_tenant_content_hash']
    ("tenant_id", "name") [unique, name: 'idx_kbdata_tenant_name']
    ("tenant_id", "purpose") [name: 'idx_kbdata_tenant_purpose']
    ("tenant_id", "role_id") [name: 'idx_kbdata_tenant_role']
    ("tenant_id", "source_type") [name: 'idx_kbdata_tenant_source']
    ("tenant_id", "current_tier") [name: 'idx_kbdata_tenant_tier']
    "created_at" [name: 'ix_KBData_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBEntityLookup" {
  "lookup_id" uuid [pk]
  "alias_name" varchar(512) [not null]
  "canonical_name" varchar(512) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "tenant_id" uuid

  indexes {
    "alias_name" [name: 'idx_kbentitylookup_alias', type: hash]
    "inserted_at" [name: 'idx_kbentitylookup_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "alias_name") [name: 'idx_kbentitylookup_tenant_alias']
    "canonical_name" [name: 'ix_KBEntityLookup_canonical_name']
    "created_at" [name: 'ix_KBEntityLookup_created_at']
  }
}

