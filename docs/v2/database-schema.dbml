  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "row_version" uuid [not null, default: `gen_random_uuid()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbextractionpolicy_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "language") [name: 'idx_kbextractionpolicy_tenant_lang']
    "created_at" [name: 'ix_KBExtractionPolicy_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBFilterPolicy" {
  "policy_id" uuid [pk]
  "tenant_id" uuid [not null]
  "policy_name" varchar(255) [not null]
  "configformat" varchar(64) [not null]
  "config" jsonb
  "is_active" bool [not null, default: false]
  "created_by" varchar(255)
  "language" varchar(32)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]
  "row_version" uuid [not null, default: `gen_random_uuid()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    "inserted_at" [name: 'idx_kbfilterpolicy_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "language") [name: 'idx_kbfilterpolicy_tenant_lang']
    "created_at" [name: 'ix_KBFilterPolicy_created_at']
  }

  Note: 'RLS bật (tenant_id = app.tenant_id)'
}

Table "KBKnowledgeBase" {
  "knowledge_base_id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "name" varchar(255) [not null]
  "description" text
  "is_active" bool [not null, default: true]
  "created_by" varchar(255)
  "created_at" timestamptz [not null, default: `now()`]
  "inserted_at" timestamptz [not null, default: `now()`]
  "is_deleted" bool [not null, default: false]

  indexes {
    "inserted_at" [name: 'idx_kbknowledgebase_inserted_at_desc', note: 'inserted_at DESC']
    ("tenant_id", "name") [unique, name: 'idx_kbknowledgebase_tenant_name']
    "created_at" [name: 'ix_KBKnowledgeBase_created_at']
  }
}

Table "KBLifecycleHistory" {
  "history_id" uuid [pk]
