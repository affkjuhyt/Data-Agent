@startuml 04-service-landscape
title Bản đồ deployable — Hiện trạng + đích V2 (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 230
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}

legend top right
  |= Màu |= Ý nghĩa |
  |<#EEF7EE> | Đã có (chạy hôm nay), dùng lại |
  |<#E6F0FF> | Đã có, cần mở rộng cho V2 |
  |<#FFF4D6> | Chưa có (đích V2) |
  Tên = thư mục backend/services/* · manifest deploy/k8s/*/service/*.yaml.
  POC chỉ thêm 2 deployable (indicator-api, forecast-worker) và 3 consumer
  trong image platform_workers (03 §1). Không có mcp-gateway, notification,
  eval hay lineage service riêng; không có service theo tên hàng hoá.
endlegend

package "Truy cập" {
  component "frontend\n(+ Data Studio · Review Inbox · Alert ·\nAnalyst Workspace; formatVN chuẩn VN)" <<extend>> as FE
  component "kong" <<reuse>> as KONG
  component "keycloak\n(+ vai trò DATA_STEWARD, REVIEWER)" <<extend>> as KC
  component "auth-api\n(+ RolePermissions cho vai trò mới)" <<extend>> as AUTH
}

package "Agent" {
  component "workflow-runtime\n(+ resolution · capability · task graph ·\nverifier đủ bằng chứng · MCP client ·\nđiều tra không cần người hỏi)" <<extend>> as WR
  component "flow-builder" <<reuse>> as FB
  component "sandbox-executor · sandbox-runner" <<reuse>> as SBX
  component "release-worker" <<reuse>> as RW
}

package "indicator-api (FastAPI, mới)" {
  component "MCP Gateway\n(Streamable HTTP; 1 gateway cho POC)" <<new>> as MCPG
  component "registry\n(entity · series · capability · operator)" <<new>> as REG
  component "governance\n(DQ · conflict · review_case · approval, OCC)" <<new>> as GOV
  component "analytics / operators\n(QuerySpec → SQLGlot → ClickHouse obs)" <<new>> as ANA
  component "knowledge · alert · lineage\n(hộp thư SSE)" <<new>> as KAL
}

component "forecast-worker\n(CPU; statsmodels · lightgbm — ngoài POC)" <<new>> as FCW

package "Ingestion · Tri thức" {
  component "kb-backend\n(KB API · Source Registry API · retrieval)" <<extend>> as KB
  component "kb-promote-silver / gold\n(+ nối bảng qua trang · heading continued)" <<extend>> as KBP
  component "kb-structured-data\n(giữ; V2 không xây trên nó)" <<reuse>> as KBS
  component "kb-conflict-resolution\n(mâu thuẫn văn bản)" <<reuse>> as KBC
}

package "platform_workers (một image, mỗi consumer một Deployment)" {
  component "web_crawler\n(chỉ deploy ở dev; + raw bất biến,\nrelease, artifact.stored, SLA)" <<extend>> as WEB
  component "audit · memory · schema_crawler" <<reuse>> as PW
  component "series_extractor\n(profile · reverse schema · mapping ·\nnormalize · candidate)" <<new>> as SX
  component "semantic_extractor\n(claim · event · observation candidate\ntừ Gold)" <<new>> as SEX
  component "detector\n(luật rẻ + MAD · significance ·\ndedup/cooldown → alert.raised)" <<new>> as DET
}

package "Model · quan sát" {
  component "model-service" <<reuse>> as MS
  component "litellm" <<reuse>> as LLM
  component "llm-exporter" <<reuse>> as LLME
  component "langfuse (+ worker) · prometheus ·\ngrafana · jaeger" <<reuse>> as OBSV
}

package "GPU host 10.10.55.101 (docker, ngoài k8s)" {
  component "vllm-main :8001 · vllm-fast :8002" <<reuse>> as VLLM
  component "TEI embed :8003 · TEI rerank :8004" <<reuse>> as TEI
}

component "libs/dq\n(thư viện DQ 5 tầng, không phải deployable)" <<new>> as LIBS

GOV ..> LIBS
@enduml
