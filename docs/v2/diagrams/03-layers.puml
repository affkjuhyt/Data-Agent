@startuml 03-layers
title Các lớp V2 (00 §2) và nơi hiện thực trên repo (03 §1) — Hiện trạng + đích (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 260
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}

legend top right
  |= Màu |= Ý nghĩa |
  |<#EEF7EE> | Đã có, dùng lại |
  |<#E6F0FF> | Có, cần mở rộng |
  |<#FFF4D6> | Chưa có, xây mới (đích V2) |
  Không tách thêm microservice trong POC: một deployable mới
  ""indicator-api"" giữ các module, ranh giới module để tách sau.
endlegend

package "Experience — frontend/src" {
  component "Ask / Analyst Workspace\n(features/ask: + task graph · lineage · VerifierBadge)" <<extend>> as UI_Ask
  component "Data Studio\n(Nguồn = SourceRegistry.tsx; Entity & Series ·\nSeries Explorer · Data Quality mới)" <<extend>> as UI_DS
  component "Review Inbox\n(từ StructuredTableReview.tsx)" <<extend>> as UI_Rev
  component "Alert · Report" <<new>> as UI_Alert
}

component "Kong + Keycloak\n(JWT · vai trò; + DATA_STEWARD, REVIEWER)" <<extend>> as GW

package "Data Agent Core — workflow_runtime" {
  component "input_refine → Resolution\n(entity · metric · time · intent qua alias registry)" <<extend>> as Res
  component "Capability Graph\n(registry.capability, nạp từ YAML\nindicator_api/capabilities/)" <<new>> as Cap
  component "Planner → Task Graph → Hybrid Executor\n(executor DAG + checkpointer có sẵn; runtime.task_run)" <<extend>> as Plan
  component "Verifier / Evidence Judge\n(libs/indicator/verifier + độ tươi + đủ bằng chứng;\nreplan ≤ 2)" <<extend>> as Ver
  component "MCP client (service assertion HMAC)" <<new>> as MCPc
}

package "Intelligence / Data API — indicator-api (FastAPI)" {
  component "MCP Gateway (Streamable HTTP)\nmỗi capability tất định = 1 tool, lọc theo vai trò" <<new>> as MCPG
  component "analytics: operators + QuerySpec\n→ SQLGlot → ClickHouse" <<new>> as Ana
  component "registry · knowledge · alert · lineage" <<new>> as Mods
  component "kb-backend (retrieval LightRAG)" <<reuse>> as KBR
  component "forecast-worker (ngoài POC)" <<new>> as FC
}

package "Semantic & Knowledge Fabric" {
  component "Postgres registry\n(entity · entity_relation · series · capability)" <<new>> as Reg
  component "Postgres knowledge\n(claim · event · evidence · relation)" <<new>> as Know
  component "Qdrant (index) · Neo4j (bản chiếu qua outbox)" <<extend>> as Proj
  component "Lõi số libs/indicator\n(Quantity · numeric · formula · threshold; + Period D/W/P)" <<extend>> as Num
}

package "Governance / Effective Data" {
  component "module governance (indicator-api) + libs/dq\nDQ 5 tầng · conflict · review_case ·\ncorrection/override · approval (OCC)" <<new>> as Gov
  component "ClickHouse obs.observation\n(mọi effective version, 4 trục thời gian)" <<new>> as Obs
  component "kb-conflict-resolution (mâu thuẫn văn bản)" <<reuse>> as TxtConf
  component "Audit (audit.data.access → platform_workers audit)" <<extend>> as Aud
}

package "Ingestion Plane" {
  component "Source Registry\n(KBSource* + kb-backend API; + licence · SLA ·\nrelease_info · extraction_profile)" <<extend>> as Src
  component "Connector runtime\nplatform_workers/web_crawler" <<extend>> as Conn
  component "Raw bất biến\nMinIO raw/{source_id}/{sha256} + ingest.release" <<extend>> as Raw
  component "series_extractor (platform_workers)\nprofile · reverse schema · mapping · normalize · candidate" <<new>> as SerX
  component "kb_promote_silver / gold\n(Docling · OCR · PageRegion · chunk/embed)" <<extend>> as Prom
  component "semantic_extractor (platform_workers)\nclaim · event · observation candidate" <<new>> as SemX
}

component "Nền: Kafka · k3s · PostgreSQL · ClickHouse · MinIO · Qdrant · Neo4j · Redis ·\nKeycloak · OpenBao · Langfuse · OTel · Prometheus/Grafana · LiteLLM → GPU host" <<reuse>> as Base

UI_Ask --> GW : REST / SSE
UI_DS --> GW
UI_Rev --> GW
UI_Alert --> GW
GW --> Res
GW --> Mods : REST
Res --> Cap
Cap --> Plan
Plan --> Ver
Plan --> MCPc
MCPc --> MCPG : MCP
MCPG --> Ana
MCPG --> Mods
MCPG --> KBR
Ana --> Obs
Ana --> Num
Mods --> Reg
Mods --> Know
Know ..> Proj : outbox
Gov --> Obs : effective version
Src --> Conn
Conn --> Raw
Raw ..> SerX : artifact.stored
Raw ..> Prom : artifact.stored
Prom ..> SemX : sau Gold
SerX ..> Gov : extraction.completed ·\nmapping.proposed
SemX ..> Gov : knowledge.proposal.created
Gov --> Know : duyệt claim/event\n(knowledge.verified)
Obs ..> FC : feature as-of
Prom --> Proj : chunk
@enduml
