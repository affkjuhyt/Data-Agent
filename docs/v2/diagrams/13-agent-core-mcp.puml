@startuml 13-agent-core-mcp
title Agent core V2 — capability registry + task graph + một MCP Gateway — Hiện trạng + đích (tô màu theo mức đã có)\n03 §10 · 00 §9, §14
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 250
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  **Không** có service sub-agent: "multi-agent không phải nền móng" (00 §14).
endlegend

package "workflow_runtime (LangGraph, một deployable)" {
  component "input_refine → route\n(+ guardrail song song · interrupt() hỏi lại)" <<reuse>> as IR
  component "resolution\nentity + metric + time + intent\n(alias registry, không đoán)" <<new>> as RES
  component "planner\nhôm nay: tot_planner (DPTS) chọn agent\nđích: task graph chỉ gồm capability đã đăng ký\n(POC: chọn một composite, điền tham số)" <<extend>> as PL
  component "hybrid executor\nhôm nay: executor DAG gọi agent in-process\nđích: node = capability, lỗi chỉ chạy lại downstream" <<extend>> as EX
  component "verifier\nhôm nay: judge + libs/indicator/verifier\n(numbers_grounded · precision · vintage · citations)\nđích: + độ tươi · đủ bằng chứng · replan ≤ 2" <<extend>> as VER
  component "summary / responder\n(LiteLLM, không tự làm toán)" <<reuse>> as SUM
  component "checkpointer Postgres\n(schema langgraph)" <<reuse>> as CP
  component "runtime.task_run\n(trạng thái từng node, resume)" <<new>> as TR
  component "MCP client\n(Streamable HTTP, service assertion HMAC)" <<new>> as MC
  package "graph của một agent (đường cũ, giữ)" {
    component "kb_search" <<reuse>> as KS
    component "tool_executor · db_connector\n(text-to-SQL chỉ cho warehouse ad-hoc)" <<reuse>> as TE
    component "mcp.py — POST JSON tới {url}/execute\n(không phải MCP; chỉ endpoint ngoài cũ)" <<reuse>> as LM
  }
}

package "indicator-api (deployable mới)" {
  component "capability registry\nYAML backend/services/indicator_api/capabilities/\n→ registry.capability" <<new>> as REG
  component "MCP Gateway (một, Streamable HTTP)\nmỗi capability deterministic = một tool\nlọc theo allowed_roles\n—— Tier B (S9-01b); POC gọi trực tiếp (S9-01)" <<new>> as GW
  component "operators (analytics)\nfetch_series · compare_period · returns ·\ndetect_drop_episodes · event_window\nQuerySpec → SQLGlot" <<new>> as OP
  component "knowledge API\nclaim · event · evidence" <<new>> as KAPI
}

component "sandbox-executor\n(SQL guard · AST guard)" <<reuse>> as SB
component "kb-backend\n(LightRAG retrieve)" <<reuse>> as KB
database "ClickHouse obs" as CH #FFF4D6
database "Postgres registry · knowledge" as PGK #FFF4D6

IR --> RES
RES --> PL : QuerySpec
PL --> REG : đọc capability
PL --> EX : task graph JSON
EX --> TR
EX ..> CP
EX --> MC
MC --> GW
GW --> OP
GW --> KAPI
OP --> CH : argMax as-of
KAPI --> PGK
EX --> KS : RETRIEVE_EVIDENCE
KS --> KB
TE --> SB
EX --> VER
VER --> PL : thiếu bằng chứng → replan
VER --> SUM : đạt

note bottom of REG
  EXPLAIN_PRICE_MOVEMENT = FETCH_SERIES → COMPARE_PERIOD →
  FIND_EVENTS → RETRIEVE_EVIDENCE → RANK_DRIVERS →
  VERIFY_DATA → VERIFY_EVIDENCE. Planner không tưởng tượng tool (bất biến 7).
end note
@enduml
