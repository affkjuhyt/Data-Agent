@startuml 24-ask
title Ask / Analyst Workspace — bố cục AskDataPage — Hiện trạng + đích V2 (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  Giữ ba cột hiện có; V2 thêm khối, không đổi khung (03 §14, E-01).
  Nhãn hôm nay tiếng Anh, ví dụ về doanh thu → nhãn Việt, ví dụ dầu/vàng (13).
endlegend

package "A · Cột trái — phạm vi" {
  component "Scope: Automatic (orchestrator chọn) | chọn agent" as A1 <<reuse>>
  component "Câu đã lưu · lịch sử 30 câu\n(localStorage, theo trình duyệt)" as A2 <<reuse>>
  component "Ngữ cảnh mang từ Alert\nentity · cửa sổ · alert_id ('Hỏi tiếp')" as A3 <<new>>
}

package "B · Giữa — hội thoại (AnswerBlock theo thứ tự cố định)" {
  component "Lời diễn giải + [n] · ClarificationCard ·\nDataGrid · ChartRenderer · EvidenceStrip ·\nCitationPanel · Export CSV · Copy SQL · gợi ý" as B1 <<reuse>>
  component "Composer: gõ · mic (Web Speech) · gửi · Stop" as B2 <<reuse>>
  component "Ví dụ câu hỏi\n(hôm nay: 'Net revenue this month by region')" as B3 <<extend>>
  component "TaskGraphView khi đang chạy\n(~__task_graph · ~__progress)" as B4 <<new>>
  component "ValueCard · VerifierBadge · RefusalCard" as B5 <<new>>
  component "As-of của câu trả lời\n(vd EIA release 23/09/2026)" as B6 <<new>>
}

package "C · Cột phải — 'Where is the number'" {
  component "EvidencePanel: How it's calculated (metric) ·\nQuery (SQL) · Data source (độ tươi) ·\nWarnings · Assumptions · Unit warnings · Sources" as C1 <<reuse>>
  component "Trích dẫn + release · available_at · licence ·\nmở trang #page=N (backend đã gửi page)" as C2 <<extend>>
  component "LineagePanel: nguồn → artifact → release →\nobservation → operator → câu trả lời" as C3 <<new>>
}

A1 -[hidden]d- A2
A2 -[hidden]d- A3
B3 -[hidden]d- B4
B4 -[hidden]d- B1
B1 -[hidden]d- B5
B5 -[hidden]d- B6
B6 -[hidden]d- B2
C1 -[hidden]d- C2
C2 -[hidden]d- C3
A1 -[hidden]r- B3
B3 -[hidden]r- C1
A3 -r-> B2 : điền sẵn ngữ cảnh
B1 -r-> C1 : chọn câu trả lời
B5 -r-> C2 : mỗi số bấm được
@enduml
