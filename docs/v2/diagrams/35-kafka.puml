@startuml 35-kafka
title Kafka — hiện trạng + đích (tô màu theo mức đã có): cấu hình, topic, producer/consumer
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 215
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  Nguồn: deploy/k8s/*/database/kafka.yaml, job/kafka-topics.yaml,
  platform_workers/common/kafka.py, libs/database_connector/kafka_connector.py
endlegend

package "Broker (apache/kafka:3.7.0)" {
  component "**1 broker** · KRaft (broker + controller cùng tiến trình)\nheap 512m · PVC 8Gi" <<extend>> as BR
  component "log.dirs = /var/lib/kafka/data trên PVC\n(trước đây /tmp: restart mất topic, ACL, offset)" <<reuse>> as LD
  component "replication.factor = 1 cho mọi topic,\ngồm cả __consumer_offsets" <<extend>> as RF
  component "auto.create.topics.enable = true\n→ đích false (P0-03)" <<extend>> as AC
  component "SASL_PLAINTEXT :8350 (PLAIN, không TLS) ·\nINTERNAL :8352 PLAINTEXT, không SASL ·\nsuper.users = admin + **ANONYMOUS**" <<extend>> as LIS
}

package "Topic do Job kafka-topics tạo (có ACL cho vài principal)" {
  component "kb.promote.silver · kb.promote.gold ·\nkb.structured.propose — 3 phân vùng\n(ACL: web-crawler-worker Write)" <<reuse>> as T1
  component "audit.data.access — 6 phân vùng · 90 ngày\n(workflow_runtime → audit-consumer)" <<reuse>> as T2
  component "memory.extraction.requested · memory.extraction.dlq ·\nddl.changes · release.pipeline.triggered/status ·\nrelease.rollback.initiated" <<reuse>> as T3
}

package "Topic chỉ có nhờ auto-create" {
  component "kb.resolve.conflict (kb-backend → kb-conflict-resolution)" <<extend>> as T4
  component "web-crawl.manual-trigger — mồ côi, không còn mã nào dùng;\nkb.ingestion.dlq · release.drift.detected — có trong mã,\nchưa khai báo" <<extend>> as T5
}

package "Topic V2 (03 §13) — khai báo trong kafka-topics + ACL trước khi dùng" {
  component "artifact.stored · source.sla.breached (key source_id)\nextraction.completed · validation.completed (key release_id)\nmapping.proposed" <<new>> as N1
  component "review.case.created · review.approved (key case_id)\nobservation.published · indicator.recomputed (key series_key)\nknowledge.proposal.created · knowledge.verified (key object_id)\nalert.raised (key entity_id)" <<new>> as N2
  component "forecast.requested/completed (ngoài POC)\nDLQ `*.dlq` cho **mọi** consumer" <<new>> as N3
}

package "Producer" {
  component "Đường KB (kb-backend, kb-promote-*): libs kafka_connector\nenable_idempotence=True · qua :8352 không xác thực" <<extend>> as P1
  component "platform_workers/common/kafka.py: acks=all · retries=5\n**không idempotence**, gửi không key" <<extend>> as P2
  component "workflow_runtime: acks=all · có key\nrelease_worker: không key" <<extend>> as P3
}

package "Consumer" {
  component "enable_auto_commit = False — commit sau khi xử lý\naudit idempotent theo source_event_id" <<reuse>> as C1
  component "8 worker Kafka (platform-workers ×4, kb-promote ×2,\nkb-conflict-resolution, kb-structured-data)\n**không liveness/readiness**" <<extend>> as C2
  component "Consumer V2: series_extractor · semantic_extractor · detector" <<new>> as C3
  component "Giám sát consumer lag" <<new>> as C4
}

BR --> LD
BR --> T1
BR --> T4
AC --> T4 : tạo im lặng
AC --> T5
N1 ..> BR : cần thêm (P0-03)
N2 ..> BR
P1 --> T1
P2 --> T1
P3 --> T2
C1 --> BR
C3 ..> N1
P2 ..> N2 : phải có idempotence + key\ntrước khi bật luồng V2

note bottom of RF
  RF=1, min ISR=1: acks=all không bảo đảm gì — mất broker là mất sự kiện
  chưa tiêu thụ. Chấp nhận cho POC 1 node; observation.published có key
  series_key để giữ thứ tự từng chuỗi (bất biến 10 không dựa vào thứ tự Kafka mà vào OCC).
end note
@enduml
