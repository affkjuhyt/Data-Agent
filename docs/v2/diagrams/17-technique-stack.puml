@startuml 17-technique-stack
title Bản đồ kỹ thuật theo tầng — Hiện trạng + đích (tô màu theo mức đã có), đo 27/09/2026
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 195
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng / đang tắt bằng cờ |
  |<#FFF4D6> | Chưa có (đích V2) |
  Mỗi ô là một **kỹ thuật**, không phải một service.
  Cờ retrieval đọc từ ""deploy/k8s/*/service/kb-backend.yaml"".
endlegend

package "1 · Điều phối (workflow_runtime)" {
  component "LangGraph StateGraph +\ncheckpointer Postgres" <<reuse>>
  component "DPTS tree search (tot_planner)" <<reuse>>
  component "Executor DAG có phụ thuộc" <<reuse>>
  component "interrupt() hỏi lại giữa chừng" <<reuse>>
  component "Capability registry + task graph\n(chỉ capability đã đăng ký)" <<new>>
  component "runtime.task_run, resume theo node" <<new>>
}

package "2 · Ngữ nghĩa & truy vấn" {
  component "compile_metric → SQL tất định\n(libs/semantic, warehouse ad-hoc)" <<reuse>>
  component "AnalyticalSlots (metric · time_range ·\ncompare_to)" <<extend>>
  component "Entity registry + alias\n(BRENT_SPOT ≠ BRENT_FUTURES_M1)" <<new>>
  component "QuerySpec + SQLGlot → ClickHouse\n(sqlglot hôm nay chỉ dùng để parse ở audit)" <<new>>
}

package "3 · An toàn thực thi (sandbox-executor)" {
  component "SQL guard hai bộ phân tích\n(sql_scan + sqlparse)" <<reuse>>
  component "AST guard Python\n(security_visitor.py)" <<reuse>>
  component "Row/byte cap + timeout" <<reuse>>
  component "gVisor chỉ ở production" <<extend>>
}

package "4 · Lõi số (libs/indicator)" {
  component "Quantity Decimal · đơn vị · bội số\n(thiếu money_per barrel/oz/lượng)" <<extend>>
  component "numeric: đọc số theo locale" <<reuse>>
  component "formula DAG · threshold" <<reuse>>
  component "verifier nối vào judge" <<reuse>>
  component "Period D/W/I/P (hôm nay A/Q/M)" <<extend>>
  component "formatVN vi-VN (E3 chưa sửa)" <<extend>>
}

package "5 · Truy xuất tri thức (kb-backend LightRAG)" {
  component "Qdrant vector + Neo4j 1 hop →\nRRF (k=60) → rerank (TEI)" <<reuse>>
  component "Cache ngữ nghĩa Qdrant (0,92 · 24 h)" <<reuse>>
  component "DOC_NARROWING · QUERY_ALIAS_RESOLVE\n(bật)" <<reuse>>
  component "HYBRID_LEXICAL (FTS Postgres)\n— có mã, tắt" <<extend>>
  component "DEGRADE_BUDGET_MS = 0 — tắt" <<extend>>
  component "Lọc evidence theo available_at" <<new>>
}

package "6 · Xử lý tài liệu" {
  component "Docling layout · TableFormer" <<reuse>>
  component "OCR Tesseract vie+eng (bật)" <<reuse>>
  component "PageRegion page + bbox,\npage trong citation" <<reuse>>
  component "Link #page=N + khung bbox trên UI" <<new>>
  component "semantic_extractor: claim / event /\nobservation candidate có quote" <<new>>
}

package "7 · Thu thập" {
  component "web_crawler cron: http_file · web_crawl(_headless) ·\nrss · rest_api · sdmx" <<reuse>>
  component "SHA-256, bỏ qua bản trùng" <<reuse>>
  component "Raw bất biến + ingest.release" <<new>>
  component "Profile · fingerprint · reverse schema\n(series_extractor)" <<new>>
}

package "8 · Governance & dữ liệu hiệu lực" {
  component "DQ 5 tầng (libs/dq)" <<new>>
  component "Conflict 7 lớp" <<new>>
  component "ReviewCase maker ≠ checker, OCC 409" <<new>>
  component "ClickHouse obs 4 trục thời gian,\nargMax as-of" <<new>>
  component "Duyệt schema bảng xlsx\n(kb_structured_data)" <<extend>>
}

package "9 · Công cụ agent" {
  component "tool_executor + tool_grant theo agent" <<reuse>>
  component "mcp.py (POST JSON tự chế)" <<extend>>
  component "MCP Gateway chuẩn (Streamable HTTP)\n— Tier B" <<new>>
}

package "10 · Chủ động" {
  component "detector: luật → MAD → significance" <<new>>
  component "dedup · group · cooldown alert" <<new>>
  component "Forecast (ngoài POC)" <<new>>
}

package "11 · Bảo mật & sự kiện" {
  component "Kong JWKS + gỡ header client" <<reuse>>
  component "Service assertion HMAC" <<reuse>>
  component "RLS app.tenant_id\n(bị bỏ qua ở service dùng admin)" <<extend>>
  component "audit.data.access → audit consumer" <<reuse>>
  component "Kafka topic V2 khai báo, tắt auto-create" <<new>>
}

package "12 · Quan sát & đánh giá" {
  component "OTEL → Jaeger · Langfuse v3" <<reuse>>
  component "model/eval scorer offline + release gate" <<reuse>>
  component "Ngưỡng online provisional" <<extend>>
  component "Golden set 60 case + scenario_27" <<new>>
}
@enduml
