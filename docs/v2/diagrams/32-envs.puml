@startuml 32-envs
title Môi trường — hiện trạng + đích (tô màu theo mức đã có): một node, bộ dev đang chạy, bộ production chỉ là manifest
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 260
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
endlegend

package "Node duy nhất 10.10.55.101 · k3s · namespace dataagent-service / -database / -sandbox" {
  component "**dev** (deploy/k8s/dev/) — đang chạy\nPSA privileged · NetworkPolicy allow-all mỗi namespace ·\nkhông gVisor · Service NodePort (port + 22000) ·\nimage localhost:5000/dataagent/<name>:latest · 1 replica, HPA min 1 ·\nplatform-workers-web-crawler **chỉ có ở đây**\n(egress Internet không giới hạn)" <<reuse>> as DEV
  component "**production** (deploy/k8s/production/) — manifest,\nchưa triển khai ở đâu (không inventory, cụm không có RuntimeClass gvisor)\nPSA restricted · default-deny-all + allow từng luồng ·\nsandbox-executor runtimeClassName gvisor · ClusterIP ·\negress chỉ tới 2 namespace nền + allow-egress-remote-llm ·\nkhông có web_crawler" <<extend>> as PROD
}

component "Ansible deploy.yml · inventory k8s-local\n(k8s_env = dev; chỉ commit đã có)" <<reuse>> as ANS
component "CI ci.yml: kubeconform + test_k8s_manifests\nkiểm cả hai bộ manifest" <<reuse>> as CI
component "release-gate.yml: eval offline + online\n(environment mặc định staging)" <<extend>> as GATE

component "staging (namespace hoặc node riêng)\ndữ liệu dầu/vàng thật, bản sao Postgres + ClickHouse obs" <<new>> as STG
component "production thật (node riêng)\ncrawler có egress allowlist theo tên miền (P0-08)" <<new>> as PRD
component "Cổng promote: golden set 06 + kịch bản 27 bước (00 §15)\n+ eval offline/online + kiểm migration trên bản sao" <<new>> as PG

ANS --> DEV : apply
CI ..> PROD : chỉ validate
CI ..> DEV : chỉ validate
DEV ..> STG : promote (đích)
GATE ..> STG : chạy trên
STG ..> PG
PG ..> PRD : đạt ngưỡng → promote (2 người duyệt)
PROD ..> PRD : dùng làm nền
@enduml
