@startuml 39-backup-dr
title Backup & DR theo từng kho — Hiện trạng + đích (tô màu theo mức đã có)\n10 §1, §4, §5 · ADR-V2-34 · P0-07
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 260
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  Một node (10.10.55.101): mọi PVC local-path, registry và
  backup đều trên cùng đĩa ""/data"" — mất đĩa là mất cả bản gốc lẫn backup.
endlegend

package "Nguồn sự thật — không tái tạo được (công duyệt của người)" {
  component "Postgres ""dataagent"" (public · langgraph · keycloak · kong;\nV2: registry · ingest · governance · knowledge · alert)\nCronJob postgres-backup: pg_dump 6 giờ, kiểm marker, giữ 7 ngày" <<extend>> as PG
  component "ClickHouse ""obs"".observation\n(effective version: correction · override)\nhôm nay chỉ có DB Langfuse, không backup" <<new>> as CH
  component "MinIO raw/{source_id}/{sha256} (bất biến)\nhôm nay: bucket knowledge-base bị xoá/ghi đè\nkhi re-crawl, không backup" <<new>> as RAW
}

package "Bản chiếu — dựng lại được (ưu tiên thấp)" {
  component "Qdrant\nhôm nay: embedding chỉ nằm ở đây (mất = embed lại)\nđích: embed_model ở Postgres, dựng lại qua outbox" <<new>> as QD
  component "Neo4j\nbản chiếu KBNeo4jNode/Relationship (Postgres)" <<extend>> as N4
  component "Kafka (1 broker, RF=1, log.dirs trên PVC)\ntopic phát lại từ raw / outbox" <<extend>> as KF
}

package "Còn lại" {
  component "Mongo: canvas agent · silver staging · conflict v1\nnguồn sự thật v1, không backup; V2 không ghi\n(chuyển sang Postgres JSONB sau POC)" <<new>> as MG
  component "OpenBao 2.6.3 (storage file)\nkhông backup; khoá unseal ở file git-ignored" <<new>> as BAO
  component "Registry localhost:5000\nbackup-registry.sh có nhưng chưa cài cron (crontab chỉ có disk-alert.sh);\n/data/registry-backups: 1 tar tay ngày 19/09" <<extend>> as REG
  component "Manifest · Ansible · config trong git;\nsecret deploy trong ansible-vault" <<reuse>> as GIT
}

package "Đích & kiểm chứng" {
  component "PVC postgres-backups 15 Gi\n(local-path, cùng node)" <<extend>> as PVC
  component "Kho backup ngoài node, mã hoá (P0-07)" <<new>> as OFF
  component "Job postgres-restore (suspend: true,\nkiểm dump trước khi DROP)\nlệch namespace: Job ở dataagent-database,\nPVC ở dataagent-service → chưa mount được" <<extend>> as RST
  component "Dựng lại bản chiếu từ outbox" <<new>> as REB
  component "Diễn tập khôi phục, đo RPO/RTO thực tế" <<new>> as DRILL
}

PG --> PVC
PVC --> OFF
CH --> OFF : BACKUP hằng ngày
RAW --> OFF : mirror
MG --> OFF
BAO --> OFF : snapshot
REG --> OFF
PVC --> RST
OFF --> DRILL
RST --> DRILL
PG --> REB
REB --> QD
REB --> N4
KF ..> RAW : phát lại
GIT --> DRILL
@enduml
