@startuml 31-gitops
title Đích V2 — CI build & ký image, Argo CD đồng bộ theo repo cấu hình (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 230
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
endlegend

package "Repo ứng dụng · Data-Agent" {
  component "Mã nguồn · Dockerfile · tests\nmodel/eval · alembic" <<reuse>> as APP
  component "Renovate / Dependabot" <<new>> as RENO
}

package "CI · GitHub Actions" {
  component "ci.yml: lint · type · unit · eval offline ·\nkubeconform (lint/type đang đỏ trên main)" <<extend>> as CI1
  component "E2E smoke (tests/e2e/e2e.sh chạy trên compose,\nchưa ở CI)" <<extend>> as CI2
  component "buildx + cache · tag = git SHA" <<new>> as CI3
  component "SBOM (syft) · trivy image (chặn CRITICAL)" <<new>> as CI4
  component "cosign ký image" <<new>> as CI5
  component "PR cập nhật tag vào repo cấu hình" <<new>> as CI6
}

component "Registry\nlocalhost:5000, tag :latest → registry có scan" <<extend>> as REG

package "Repo cấu hình" {
  component "deploy/k8s/{dev,production}\n(đang nằm trong repo ứng dụng)" <<extend>> as BASE
  component "overlays dev · prod (Kustomize)" <<new>> as OVL
  component "apps/ (Argo CD app-of-apps)" <<new>> as APPS
}

package "Cluster k3s 10.10.55.101" {
  component "Argo CD\n(sync · phát hiện drift · rollback = git revert)" <<new>> as ARGO
  component "Job kafka-topics (topic 03 §13 + ACL)\n= sync wave 0" <<extend>> as TOP
  component "Job migrate (alembic): schema registry · ingest ·\ngovernance · knowledge + ClickHouse obs\n= PreSync hook" <<extend>> as MIG
  component "External Secrets Operator" <<new>> as ESO
  component "OpenBao 2.6.3" <<reuse>> as BAO
  component "Kyverno\n(verify chữ ký · policy)" <<new>> as KYV
  component "Workload (namespace service · database · sandbox)\n+ indicator-api, consumer V2 mới" <<extend>> as WL
}

component "Ansible deploy.yml\n(hôm nay: đường deploy duy nhất; đích: chỉ còn\nbootstrap node, OpenBao, GPU)" <<reuse>> as ANS

APP --> CI1
RENO --> APP : PR nâng phụ thuộc
CI1 --> CI2
CI2 --> CI3
CI3 --> CI4
CI4 --> CI5
CI5 --> REG : push
CI5 --> CI6
CI6 --> OVL : PR tag mới
BASE --> OVL
APPS --> ARGO
ARGO --> OVL : theo dõi
ARGO --> MIG : sync wave 0
ARGO --> TOP : sync wave 0
ARGO --> WL : sync wave 1
ESO --> BAO : đọc secret
ESO --> WL : k8s Secret
KYV --> REG : verify cosign
KYV --> WL : admission
ANS --> BAO : unseal · AppRole
ANS ..> WL : hôm nay: apply trực tiếp
@enduml
