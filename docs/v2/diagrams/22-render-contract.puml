@startuml 22-render-contract
title Hợp đồng render câu trả lời — Hiện trạng + đích V2 (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  Quy tắc (03 §10.3, 13): capability đã đăng ký quyết định khối hiển thị.
  LLM chỉ viết lời diễn giải: **không** chọn khối, **không** sinh số.
  Mọi số hiển thị lấy từ giá trị có kiểu (value · unit · precision) qua formatVN.
endlegend

package "1 · Ý định → capability (planner chỉ chọn composite đã đăng ký)" {
  component "COMPARE_PERIOD\n'Brent TB 30 ngày so 30 ngày trước?'" as I1 <<new>>
  component "COMPARE_EPISODES\n'So với 3 lần gần nhất?'" as I2 <<new>>
  component "EXPLAIN_PRICE_MOVEMENT\n'Brent giảm 12,16 % vì sao?'" as I3 <<new>>
  component "EXPLAIN_FUEL_ADJUSTMENT\n'Kỳ điều hành 24/09/2026?'" as I4 <<new>>
  component "Tra cứu tài liệu (UC09)\n'OPEC nhận định gì về nguồn cung?'\n(retrieval LightRAG có)" as I5 <<extend>>
  component "SQL ad-hoc trên warehouse\n(text-to-SQL hiện có)" as I6 <<reuse>>
}

package "2 · Khối hiển thị" {
  component "ValueCard\ngiá trị · đơn vị · kỳ · 4 trục thời gian ·\nrelease · licence" as B1 <<new>>
  component "DataGrid\nsort · phân trang · CSV · Excel + Nguồn" as B2 <<reuse>>
  component "ChartRenderer (Recharts, 8 loại)\nhôm nay LLM chọn chart_type/x/y,\ndữ liệu lấy từ rows thật" as B3 <<extend>>
  component "EvidencePanel · CitationPanel\nmetric · SQL · độ tươi · trích dẫn\n(thiếu release · available_at · #page=N)" as B4 <<extend>>
  component "SourceRefChip → trang tài liệu #page=N\n(khung bbox: Tier B)" as B5 <<new>>
  component "LineagePanel\nnguồn → artifact → release →\nobservation → operator → câu trả lời" as B6 <<new>>
  component "TaskGraphView\nnode · capability · trạng thái" as B7 <<new>>
}

package "3 · Kèm mọi câu trả lời / trạng thái không trả lời" {
  component "VerifierBadge\nnumbers_grounded · tolerance_ok ·\nvintage_consistent · citations_resolved\n(verifier đã chạy trong judge; UI chưa có)" as C1 <<new>>
  component "ClarificationCard · gợi ý hỏi tiếp" as C2 <<reuse>>
  component "RefusalCard\nNO_DATA_FOR_PERIOD · FREQUENCY_NOT_AVAILABLE ·\nSERIES_NOT_APPROVED · STALE_SOURCE ·\nACCESS_DENIED · INSUFFICIENT_EVIDENCE" as C3 <<new>>
}

package "4 · Frame SSE" {
  component "Có: ~__session_id · ~__reset · ~__clarification ·\n~__pending_review · ~__chart · ~__citations ·\n~__evidence · ~__suggestions · ~__options · ~__conv_ids" as F1 <<reuse>>
  component "Thêm (03 §10.3): ~__intent · ~__task_graph ·\n~__progress · ~__indicator_value ·\n~__verification · ~__lineage · ~__refusal" as F2 <<new>>
}

I1 --> B1
I1 --> B3
I2 --> B2
I2 --> B3
I2 --> B6
I3 --> B1
I3 --> B7
I3 --> B4
I4 --> B1
I4 --> B5
I5 --> B4
I5 --> B5
I6 --> B2
I6 --> B3

B1 ..> B5 : mỗi số bấm được
B2 ..> B5
B4 ..> B5

F1 ..> B2 : __evidence
F1 ..> B3 : __chart
F1 ..> C2 : __clarification
F2 ..> B1 : __indicator_value
F2 ..> B7 : __task_graph · __progress
F2 ..> B6 : __lineage
F2 ..> C1 : __verification
F2 ..> C3 : __refusal

note bottom of I2
  Bước 27 (08): bảng 3 đợt Brent giảm ≥5 %/5 phiên —
  22/09/2026 −12,16 % (130,80 → 114,89) ·
  25/08/2026 −7,40 % · 28/07/2026 −12,73 %
  + chart + evidence ±3 ngày + lineage tới release EIA 23/09.
end note
@enduml
