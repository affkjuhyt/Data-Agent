@startuml 00-system-context
title Sơ đồ bối cảnh (C4 · mức 0) — Data Agent V2 dầu/vàng — Hiện trạng + đích (tô màu theo mức đã có)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 220
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
skinparam actor<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam actor<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam actor<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Ý nghĩa |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
  Nguồn: màu = mức kết nối hôm nay (connector có sẵn
  nhưng nguồn dầu/vàng chưa đăng ký = xanh dương).
  Actor: màu = vai trò Keycloak đã có hay chưa.
  Mũi tên vàng = luồng chỉ có ở đích V2.
  Bên trong: sơ đồ 03-layers · 04-service-landscape.
endlegend

actor "Lãnh đạo\n(EXECUTIVE)" <<reuse>> as EXEC
actor "Chuyên viên phân tích\n(ANALYST; hôm nay\ngần nhất là BUSINESS_OPERATOR)" <<extend>> as ANA
actor "Data steward\n(DATA_STEWARD)" <<new>> as STE
actor "Reviewer · checker\n(REVIEWER)" <<new>> as REV
actor "AI engineer · QA eval\n(AI_ENGINEER)" <<reuse>> as AIE
actor "Quản trị\n(PLATFORM_ADMIN)" <<reuse>> as ADM

rectangle "**DATA AGENT V2**\nThu nhận nguồn dầu/vàng → raw bất biến →\nobservation có 4 trục thời gian + claim/event/evidence →\nduyệt người (maker–checker) → effective data →\nagent trả lời, điều tra, cảnh báo có bằng chứng" as SYS #F7F7F2

package "Nguồn quốc tế" {
  component "EIA\n(RBRTEd.xls Brent ngày, công bố thứ Tư ·\nWPSR · STEO) — http_file" <<extend>> as EIA
  component "World Bank Pink Sheet\n(xlsx tháng; URL file đổi mỗi bản)" <<extend>> as WB
  component "IMF PCPS\n(SDMX: Brent · WTI · Dubai · PGOLD)" <<extend>> as IMF
  component "OPEC\n(MOMR PDF · basket) — 403 từ máy chủ" <<new>> as OPEC
}

package "Nguồn Việt Nam" {
  component "Bộ Công Thương\n(thông cáo điều hành giá xăng theo kỳ,\nví dụ kỳ 24/09/2026)" <<extend>> as MOIT
  component "Petrolimex\n(giá bán lẻ xăng dầu)" <<extend>> as PLX
  component "SJC · PNJ · DOJI\n(giá vàng mua/bán; 403 hoặc cần JS)" <<new>> as SJC
  component "Vietcombank\n(tỷ giá XML; 1 request/5 phút)" <<extend>> as VCB
}

package "Hệ thống nội bộ" {
  component "Keycloak (SSO, OIDC)" <<reuse>> as SSO
  component "Warehouse ngoài\n(Postgres · Snowflake · ClickHouse;\nSQL chỉ đọc qua sandbox)" <<reuse>> as DWH
}

package "GPU host 10.10.55.101 (ngoài k8s, docker)" {
  component "vllm-main :8001 · vllm-fast :8002 ·\nTEI embed :8003 · TEI rerank :8004\n(A100 40 GB dùng chung; qua LiteLLM)" <<reuse>> as GPU
}

EXEC --> SYS : hỏi · xem cảnh báo
ANA --> SYS : phân tích giá · as-of ·\nhỏi tiếp từ alert
STE --> SYS : đăng ký nguồn · entity/series ·\nmapping · luật DQ
REV --> SYS : duyệt ReviewCase ·\ncorrection/override
AIE --> SYS : agent · golden set · eval
ADM --> SYS : quyền · vận hành

EIA --> SYS : xls · API (key)
WB --> SYS : xlsx (đọc trang landing)
IMF --> SYS : SDMX
OPEC -[#C08A00]-> SYS : PDF (headless/tải tay)
MOIT --> SYS : HTML · PDF
PLX --> SYS : HTML
SJC -[#C08A00]-> SYS : HTML (headless)
VCB --> SYS : XML

SSO <--> SYS : xác thực người dùng
DWH --> SYS : SQL chỉ đọc
SYS <--> GPU : suy luận · embed · rerank
SYS -[#C08A00]-> ANA : alert chủ động (hộp thư SSE)
SYS -[#C08A00]-> REV : ReviewCase theo authority

note bottom of SYS
  **Hiện trạng 27/09/2026**: web_crawler chạy cron cho 35 nguồn đã đăng ký (không nguồn nào
  là dầu/vàng; chỉ deploy ở dev); số từ rest_api/sdmx dừng ở Bronze dạng byte thô.
  Chưa có observation, ReviewCase, alert; vai trò DATA_STEWARD/REVIEWER chưa có.
  Egress của crawler chưa có allowlist tên miền (P0-08).
  Ranh giới **không gồm**: ghi ngược ra nguồn (hệ thống chỉ đọc), nguồn cần licence
  (ICE, Platts, LBMA/IBA — 04 §2).
end note
@enduml
