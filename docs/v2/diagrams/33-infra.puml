@startuml 33-infra
title Hạ tầng — hiện trạng + đích (tô màu theo mức đã có): 1 node k3s + GPU ngoài k8s, đích HA
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 250
skinparam ArrowColor #555555
skinparam node<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam node<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam node<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
endlegend

package "Hiện trạng" {
  node "Server 10.10.55.101 · Ubuntu 22.04 · A100 40 GB dùng chung\n/ 163 GB (chỉ OS) · /data 1 TB" <<reuse>> as CUR {
    component "k3s 1 node (control-plane + worker)\nkhông Ingress · metrics-server · HPA 4 Deployment" <<reuse>> as K3S
    component "ns dataagent-service\nkong · keycloak · frontend · auth-api · flow-builder ·\nkb-backend · kb-promote-silver/gold · kb-conflict-resolution ·\nkb-structured-data · workflow-runtime · model-service ·\nsandbox-executor · litellm · llm-exporter ·\nplatform-workers {audit, memory, schema-crawler, web-crawler} ·\nlangfuse(+worker) · prometheus · grafana · jaeger" <<reuse>> as NSS
    component "ns dataagent-database (StatefulSet 1 replica)\npostgres 16 (+pgbouncer) · clickhouse (chỉ Langfuse) ·\nkafka 3.7 · minio · mongo 7 · neo4j 5.20 ·\nopenbao 2.6.3 · qdrant 1.13.6 · redis 7" <<reuse>> as NSD
    component "ns dataagent-sandbox\npod chạy code (pool của sandbox-executor)" <<reuse>> as NSB
    component "PVC local-path (1 bản, cùng node)\nCronJob postgres-backup 6 h → PVC postgres-backups\nMinIO · Mongo · Neo4j · Qdrant · ClickHouse: không backup" <<extend>> as LP
    component "docker ngoài k8s (host network)\nvllm-main :8001 · vllm-fast :8002 (vllm-openai:latest)\nTEI embed :8003 · TEI rerank :8004" <<extend>> as DGPU
    component "registry:2 localhost:5000\nbackup-registry.sh (cron host)" <<reuse>> as LREG
    component "/data bind mount (27/09/2026):\n/var/lib/{rancher,kubelet,containerd,docker}\n+ registry · models · logs\ndisk-alert.sh (cron 15 phút, ngưỡng 80 %)" <<reuse>> as DISK
  }
}

package "Đích (sau POC)" {
  node "Control plane ×3\n(k3s HA embedded etcd)" <<new>> as CP
  node "Worker CPU ×2–3\n(service · database · sandbox)" <<new>> as WK
  node "GPU node A100\nGPU Operator · dcgm-exporter ·\nvLLM/TEI Deployment ghim version" <<new>> as GPU
  node "Storage phân tán + MinIO nhiều node\n(raw/{source_id}/{sha256} bất biến)" <<new>> as ST
  node "Registry có scan + ký" <<new>> as HB
  node "Ingress + cert-manager (TLS)" <<new>> as ING
  node "Egress proxy / allowlist cho crawler (P0-08)" <<new>> as EGR
  node "Backup ngoài node / ngoài site\n(Postgres P0-07, MinIO raw, ClickHouse obs)" <<new>> as OFF
}

NSS ..> DGPU : LiteLLM / model-service
CUR ..> CP : chuyển dần
CP --> WK
CP --> GPU
WK --> ST
GPU --> ST
ST --> OFF : replication · snapshot
HB --> WK : pull image đã ký
ING --> WK
WK --> EGR : crawler ra Internet
@enduml
