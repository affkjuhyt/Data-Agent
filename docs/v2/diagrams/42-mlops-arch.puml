@startuml 42-mlops-arch
title Kiến trúc MLOps / LLMOps — Hiện trạng + đích (tô màu theo mức đã có)\n00 §12 · 03 §2, §12 · 06 §5
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 240
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có (chạy hôm nay) |
  |<#E6F0FF> | Có một phần / cần mở rộng |
  |<#FFF4D6> | Chưa có (đích V2) |
endlegend

package "GPU host 10.10.55.101 — docker ngoài k8s, 1 A100 40 GB dùng chung" {
  component "vllm-main :8001\nQwen3-14B-AWQ (agent-main)\nvllm-openai:latest, không ghim HF revision" <<extend>> as VM
  component "vllm-fast :8002\nQwen3-4B-AWQ (agent-fast)\nvllm-openai:latest" <<extend>> as VF
  component "TEI :8003 bge-m3 (embed)\nTEI :8004 bge-reranker-v2-m3\nimage 1.9" <<reuse>> as TEI
}

package "Serving trong k8s" {
  component "LiteLLM: alias planner · responder · judge ·\ntext_to_sql · orchestrator-planner · guardrail · embedder\n(không fallbacks, cache tắt)" <<reuse>> as LLR
  component "model_service\nembed · rerank (batching) · generate" <<reuse>> as MS
  component "workflow_runtime · kb_backend · kb_promote_*\n(rerank, embed ingest qua model_service)" <<reuse>> as WR
  component "Canary / shadow theo trọng số" <<new>> as CAN
}

package "Tài sản có version (git)" {
  component "Prompt ""prompts/*.txt"" + bảng SystemPrompts" <<extend>> as PR
  component "litellm config.yaml → ConfigMap litellm-config" <<reuse>> as LLC
  component "Golden set ""model/eval/cases/*.jsonl""\n(chưa có commodity.jsonl)" <<extend>> as GS
  component "Agent/workflow version (flow-builder) ·\nrelease_worker: scan · duyệt; deploy còn giả lập" <<extend>> as AGV
}

package "Đánh giá & gate" {
  component "model/eval offline (policy · SQL)\nCI eval-gate, chặn" <<reuse>> as EO
  component "model/eval online (intent · unsupported ·\nRAGAS faithfulness · unsupported_number)\nrelease-gate.yml; ngưỡng provisional" <<extend>> as EON
  component "model/bench + bench-gate\n(thresholds.json từ baseline 22/09) · bench-e2e" <<reuse>> as BN
}

package "Giám sát model" {
  component "Langfuse v3 (ClickHouse + MinIO)\ntrace cùng trace_id OTEL" <<reuse>> as LF
  component "llm_exporter probe agent-main\n→ Prometheus → Grafana kb-ccu" <<reuse>> as LLE
  component "Langfuse score · feedback người dùng" <<new>> as LFS
}

package "Định lượng V2 (ngoài POC)" {
  component "forecast-worker (CPU)\nstatsmodels · lightgbm · scikit-learn" <<new>> as FW
  component "Feature snapshot Parquet\nMinIO theo SHA-256 (available_at ≤ as_of)" <<new>> as FS
  component "Postgres forecast.model_version · forecast_run" <<new>> as FMV
  component "MLflow (nếu kịp)" <<new>> as MLF
}

WR --> LLR
WR --> MS
LLR --> VM
LLR --> VF
LLR --> TEI : embedder
MS --> TEI
MS --> VF
LLE --> VM
WR --> LF
LF --> LFS
LLC --> LLR
CAN ..> LLR
EO --> GS
EON --> GS
EON --> WR
BN --> VM
BN --> VF
BN ..> LLR : --target litellm
WR --> FW : forecast.requested
FW --> FS
FW --> FMV
FMV ..> MLF
@enduml
