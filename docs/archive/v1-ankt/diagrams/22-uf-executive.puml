@startuml 22-uf-executive
title Luồng giao diện — Lãnh đạo
skinparam shadowing false
skinparam defaultFontName "Arial"
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
endlegend

start
#EEF7EE:Đăng nhập SSO (Keycloak);
#FFF4D6:**Dashboard ANKT**
heatmap domain × trạng thái (xanh/vàng/cam/đỏ) ·
số cảnh báo mới · bản tin gần nhất;
split
  #FFF4D6:Bấm ô vàng/đỏ trên heatmap;
split again
  #FFF4D6:Mở **hộp cảnh báo** → chọn cảnh báo;
split again
  #FFF4D6:Mở **bản tin định kỳ**;
end split
#FFF4D6:**Trang tóm tắt chỉ số**
giá trị kỳ mới nhất · xu hướng · dải ngưỡng theo giai đoạn ·
"vì sao thay đổi" (agent tóm tắt, có trích dẫn) · vintage;
split
  #E6F0FF:Hỏi thêm trong khung chat
  (Ask có; ngữ cảnh chỉ số tự điền chưa có);
  #EEF7EE:Xem câu trả lời + nguồn;
split again
  #E6F0FF:Mở trích dẫn → tài liệu gốc
  (có mở file; chưa tới đúng trang);
split again
  #FFF4D6:Giao chuyên viên phân tích sâu
  (tạo nhiệm vụ kèm link);
split again
  #FFF4D6:Tải bản tin PDF/DOCX có nguồn;
end split
#FFF4D6:Đánh giá hữu ích / báo sai;
stop
@enduml
