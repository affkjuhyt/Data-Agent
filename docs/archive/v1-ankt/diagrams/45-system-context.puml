@startuml 45-system-context
title Sơ đồ bối cảnh (C4 · mức 1) — Data Agent trong môi trường An ninh kinh tế
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 210
skinparam component<<have>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<partial>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<missing>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái kết nối |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
  Phạm vi: **một hệ thống duy nhất** và những gì nằm ngoài ranh giới của nó.
  Chi tiết bên trong: [15] bản đồ service · [07] các lớp nền tảng.
endlegend

actor "Lãnh đạo" as EXEC
actor "Chuyên viên phân tích" as ANA
actor "Data steward" as STE
actor "Nhóm Research\n· Reviewer nghiệp vụ" as RES
actor "QA / Eval" as QA
actor "Quản trị hệ thống" as ADM

rectangle "**DATA AGENT**\nNền tảng hỏi đáp và phân tích đa chỉ số\nAn ninh kinh tế — có trích dẫn nguồn,\nvintage và ngưỡng theo giai đoạn" as SYS #F7F7F2

package "Nguồn dữ liệu chính thức Việt Nam" {
  component "Bộ Tài chính\n(bản tin nợ công · NSNN)" <<partial>> as MOF
  component "Cục Thống kê (NSO)\n(niên giám · báo cáo tháng · PxWeb)" <<partial>> as NSO
  component "Ngân hàng Nhà nước" <<missing>> as SBV
  component "Cục Hải quan" <<missing>> as CUS
  component "Quốc hội · Văn phòng Chính phủ\n(văn bản pháp luật · nghị quyết)" <<partial>> as LAW
}

package "Nguồn quốc tế (đối chiếu)" {
  component "IMF · World Bank\n(SDMX · REST)" <<missing>> as IFI
  component "ADB · BIS · OECD · UN ·\nAMRO · ASEAN" <<missing>> as INTL
  component "FRED · GDELT · thị trường" <<missing>> as MKT
}

package "Hệ thống nội bộ của tổ chức" {
  component "Keycloak / SSO tổ chức" <<have>> as SSO
  component "Data warehouse nội bộ\n(Postgres · ClickHouse · Snowflake)" <<have>> as DWH
  component "Email · Slack/Teams\n(thông báo)" <<missing>> as MSG
}

package "Dịch vụ AI" {
  component "LiteLLM → vLLM tự vận hành\n(Qwen3 14B/4B · embed · rerank)" <<have>> as LLM
}

EXEC --> SYS : xem dashboard · cảnh báo ·\nbản tin · hỏi có bằng chứng
ANA --> SYS : phân tích chỉ số · so sánh ·\nphân rã · soạn báo cáo
STE --> SYS : duyệt số liệu · quản nguồn ·\nxử lý issue dữ liệu
RES --> SYS : định nghĩa chỉ số · ngưỡng ·\nduyệt phiên bản
QA --> SYS : golden set · chạy eval ·\nbenchmark model
ADM --> SYS : quyền · phân loại dữ liệu ·\nvận hành

MOF --> SYS : PDF (có bản scan) — thủ công/tải tệp
NSO --> SYS : PDF · XLSX · web
SBV --> SYS : báo cáo PDF/web
CUS --> SYS : số liệu XNK
LAW --> SYS : văn bản · hiệu lực
IFI --> SYS : SDMX / REST API
INTL --> SYS : API · tệp
MKT --> SYS : API · RSS

SSO <--> SYS : xác thực người dùng (OIDC)
DWH --> SYS : truy vấn SQL chỉ đọc
SYS --> MSG : cảnh báo · bản tin
SYS <--> LLM : suy luận · embedding · rerank

note bottom of SYS
  **Thực trạng 09/2026**: 38 nguồn đã khảo sát ([DATA-SOURCES.md]),
  nhưng chưa có connector tự động nào — dữ liệu vào bằng tải tệp thủ công.
  Ranh giới hệ thống **không bao gồm**: hệ thống nghiệp vụ của các bộ ngành,
  kho dữ liệu quốc gia, và mọi đường ghi ngược ra nguồn (hệ thống chỉ đọc).
end note
@enduml
