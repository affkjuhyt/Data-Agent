@startuml 03-indicator-pipeline
title Luồng dữ liệu một chỉ số: từ tài liệu nguồn đến đáp án chuẩn (golden case)
skinparam shadowing false
skinparam defaultFontName "Arial"
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
endlegend

|Nguồn|
start
:Tài liệu nguồn
(Bản tin nợ công PDF · số liệu GDP của NSO ·
API World Bank/IMF · Excel báo cáo);
|Connector Hub|
#FFF4D6:Thu thập theo lịch
(phát hiện bản mới bằng hash · lưu MinIO);
#FFF4D6:Đăng ký Source Registry
(tên · số hiệu · ngày ban hành · cơ quan · URL · SHA-256);
|Extraction|
if (Loại nguồn?) then (PDF / ảnh scan)
  #E6F0FF:OCR + layout + table structure
  (Docling có; OCR đang tắt; chưa lưu trang/bbox);
else (API / Excel)
  #E6F0FF:Parse có cấu trúc
  (có import xlsx/csv 1 bảng; chưa có SDMX/JSON);
endif
#FFF4D6:Sinh candidate observations
(value · unit · multiplier · period ·
source_ref: trang/bảng/ô);
|Data steward|
#E6F0FF:Duyệt trên workbench
(có màn duyệt schema bảng; chưa có ảnh trang + ô số);
if (Giá trị đúng?) then (duyệt)
else (sai)
  #FFF4D6:Sửa giá trị, ghi lý do;
endif
|Observation Store|
#FFF4D6:Ghi observation gắn release/vintage
(ước thực hiện · sơ bộ · chính thức · quyết toán);
|Computation & Validation|
#FFF4D6:Tính chỉ số theo formula DAG
(căn kỳ stock/flow · quy đổi đơn vị · làm tròn);
#FFF4D6:Reconcile: tự tính vs số chính thức;
if (|Δ| ≤ dung sai?) then (khớp)
  #FFF4D6:Đánh giá ngưỡng
  (chọn ngưỡng theo valid_from/valid_to của kỳ);
else (lệch)
  #FFF4D6:Mở issue reconciliation
  (nguyên nhân: vintage · phạm vi · làm tròn · lỗi trích xuất);
  stop
endif
|Eval|
#FFF4D6:Sinh golden case
(câu hỏi · đáp số · dung sai · trạng thái ngưỡng ·
tài liệu nguồn tên/số/ngày/trang · vintage);
#E6F0FF:Reviewer duyệt → Langfuse Dataset
(Langfuse có; Datasets chưa dùng);
stop
@enduml
