@startuml 10-multi-agent-sequence
title Câu hỏi đa bước: "Vì sao nợ công/GDP giảm 2016–2020 trong khi nghĩa vụ trả nợ/thu NSNN tăng? So với ASEAN và rủi ro theo ngưỡng?"
skinparam shadowing false
skinparam defaultFontName "Arial"
autonumber
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
endlegend

actor "Chuyên viên" as U
participant "Router\n(input_refine · route)" as R #E6F0FF
participant "Supervisor\n(ToT planner · executor DAG)" as S #E6F0FF
participant "Indicator\nAnalyst" as IA #FFF4D6
participant "Legal\nResearcher" as LR #FFF4D6
participant "International\nComparator" as IC #FFF4D6
participant "MCP tools\n(indicator · data · compute ·\nsource · intl)" as T #FFF4D6
participant "Verifier\n(judge hiện có)" as V #E6F0FF
participant "Synthesizer\n(summary node)" as SY #E6F0FF

U -> R : câu hỏi
R -> R : đa chỉ số + so sánh quốc tế + ngưỡng\n→ đường multi-agent
R -> U : làm rõ: "ASEAN gồm những nước nào?"
U -> R : ASEAN-5
R -> S : câu hỏi đã làm rõ
S -> T : search_indicators("nợ công/GDP", "nghĩa vụ trả nợ/thu NSNN")
T --> S : ECO-D2-S22-001 · ECO-D2-S22-004
S -> S : lập DAG: t1 số liệu + phân rã · t2 ngưỡng theo kỳ ·\nt3 so sánh ASEAN-5 · t4 tổng hợp

par t1
  S -> IA : phân tích 2 chỉ số 2016–2020
  IA -> T : query(indicators, 2016..2020, vintage=mới nhất)
  T --> IA : chuỗi + source_ref
  IA -> T : decompose_change(nợ công/GDP)
  T --> IA : đóng góp: dư nợ · GDP · đánh giá lại GDP
  IA --> S : kết quả + evidence
else t2
  S -> LR : ngưỡng áp dụng từng năm
  LR -> T : get_thresholds + search_legal(effective_at)
  T --> LR : ngưỡng theo giai đoạn + văn bản · trang
  LR --> S : bảng ngưỡng theo năm + căn cứ
else t3
  S -> IC : so sánh ASEAN-5
  IC -> T : worldbank_series / imf_series + map_perimeter
  T --> IC : số liệu quốc tế + khác biệt phạm vi
  IC --> S : so sánh kèm cảnh báo phạm vi
end

S -> V : kết quả t1–t3
V -> V : số ⊆ evidence ± dung sai?\nvintage nhất quán? trích dẫn đúng trang?
alt Đạt
  V -> SY : cho phép tổng hợp
else Không đạt
  V -> S : yêu cầu làm lại bước lỗi
end
SY --> U : câu trả lời + biểu đồ + bảng ngưỡng + nguồn
@enduml
