@startuml 23-uf-analyst
title Luồng giao diện — Chuyên viên phân tích
skinparam shadowing false
skinparam defaultFontName "Arial"
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
endlegend

start
split
  #FFF4D6:**Danh mục chỉ số**: tìm theo tên/bí danh,
  lọc domain → sub-domain → trạng thái;
split again
  #EEF7EE:**Ask Data**: đặt câu hỏi tự do;
  if (Câu hỏi mơ hồ?) then (có)
    #EEF7EE:Thẻ làm rõ: chọn phương án hoặc gõ thêm;
  else (không)
  endif
  #E6F0FF:Câu trả lời stream + evidence
  (có; thẻ chỉ số chưa có);
end split
#FFF4D6:**Trang chỉ số**
định nghĩa · công thức · biến · ngưỡng theo giai đoạn ·
chuỗi thời gian · bảng quan sát kèm nguồn;
#FFF4D6:Chọn kỳ · vintage (bản ước/sơ bộ/chính thức) ·
so sánh (nguồn khác · nước khác · chỉ số liên quan);
if (Cần giải thích biến động?) then (có)
  #FFF4D6:Bấm "Phân rã" → đóng góp từng biến;
else (không)
endif
#E6F0FF:Hỏi agent ở panel bên cạnh
(chat có; panel theo ngữ cảnh chỉ số chưa có);
#E6F0FF:Mở trích dẫn → trang tài liệu gốc có highlight
(có mở file; chưa có trang + highlight);
if (Thấy số đáng ngờ?) then (có)
  #FFF4D6:Đánh dấu sai → tạo issue dữ liệu
  (gửi data steward);
else (không)
endif
split
  #E6F0FF:Lưu phân tích
  (hiện: lưu câu hỏi trong localStorage);
split again
  #EEF7EE:Xuất Excel kèm sheet "Nguồn";
split again
  #FFF4D6:Thêm vào báo cáo → soạn bản tin (agent hỗ trợ)
  → gửi duyệt;
end split
stop
@enduml
