@startuml 28-infra-topology
title Hạ tầng — hiện tại (1 node) và mục tiêu (HA · GPU trong k8s · backup ngoài site)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam wrapWidth 240
skinparam node<<have>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam node<<partial>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam node<<missing>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
skinparam component<<have>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<partial>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<missing>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  |= Màu |= Trạng thái |
  |<#EEF7EE> | Đã có |
  |<#E6F0FF> | Có một phần |
  |<#FFF4D6> | Chưa có |
endlegend

package "Hiện tại" {
  node "Server 10.10.55.101\nA100 40GB · ổ 163 GB (81%)" <<have>> as CUR {
    component "k3s single node\n3 namespace · PodSecurity restricted ·\nNetworkPolicy · HPA 4 service" <<have>> as K3S
    component "local-path PVC\n(backup Postgres cùng node)" <<partial>> as LP
    component "registry localhost:5000" <<have>> as LREG
    component "docker run vLLM/TEI :latest\n(ngoài k8s)" <<partial>> as DGPU
  }
}

package "Mục tiêu" {
  node "Control plane ×3\n(k3s HA embedded etcd / RKE2)" <<missing>> as CP
  node "Worker CPU ×2–3\n(service · database · sandbox)" <<missing>> as WK
  node "GPU node A100\nGPU Operator · MIG/time-slicing ·\ndcgm-exporter · vLLM/TEI Deployment ghim version" <<partial>> as GPU
  node "Storage phân tán\n(Longhorn) + MinIO cluster" <<missing>> as ST
  node "Harbor registry\n(scan · ký · proxy cache)" <<missing>> as HB
  node "Ingress + cert-manager (TLS)" <<missing>> as ING
  node "Staging\n(namespace/cluster riêng)" <<missing>> as STG
  node "Site backup ngoài\n(S3/MinIO site 2)" <<missing>> as OFF
}

CUR ..> CP : chuyển dần
CP --> WK
CP --> GPU
WK --> ST
GPU --> ST
ST --> OFF : replication · snapshot
HB --> WK : pull image đã ký
ING --> WK
STG --> HB
@enduml
