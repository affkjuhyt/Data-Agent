@startuml 47-domain-state-machines
title Vòng đời các đối tượng nghiệp vụ — trạng thái và điều kiện chuyển
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam wrapWidth 170
skinparam state {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
legend top right
  Cả bốn máy trạng thái **chưa có trên hệ thống** (09/2026); chúng là hợp đồng
  nghiệp vụ mà indicator-catalog-svc, observation-svc, curation-svc và alert-svc
  phải hiện thực ([SERVICE-DESIGN] mục 3). Ô xanh = trạng thái đích mong muốn.
  Tái dùng được: draft/approved của metric contract trong semantic layer.
endlegend

state "1 · Phiên bản chỉ số — indicator_version" as M1 {
  state "draft" as I1
  state "submitted" as I2
  state "approved" as I3 #EEF7EE
  state "deprecated" as I4
  [*] --> I1 : Research tạo trên Indicator Studio
  I1 --> I2 : gửi duyệt — qua kiểm tra tự động\n(polarity · stock/flow · đơn vị ·\nngưỡng không chồng kỳ)
  I2 --> I1 : Reviewer từ chối, ghi lý do
  I2 --> I3 : Reviewer nghiệp vụ duyệt →\nbất biến, phát `indicator.version.approved`
  I3 --> I4 : có phiên bản mới thay thế
  I4 --> [*]
}
note bottom of M1
  Phiên bản đã duyệt **không sửa được**. Đổi công thức hoặc ngưỡng
  = phiên bản mới; phiên bản cũ vẫn tra được cho kỳ cũ.
end note

state "2 · Kỳ công bố số liệu — release → observation" as M2 {
  state "detected" as R1
  state "artifact_stored" as R2
  state "extracted" as R3
  state "mapped" as R4
  state "validated" as R5
  state "in_review" as R6
  state "published" as R7 #EEF7EE
  state "retracted" as R8
  [*] --> R1 : sensor phát hiện bản mới\n(hash · ETag · diff trang)
  R1 --> R2 : tải về MinIO + SHA-256\n(trùng hash → dừng)
  R2 --> R3 : OCR · layout · bảng · VLM\n→ ứng viên có trang/bbox
  R3 --> R4 : ánh xạ ô → biến · chiều · kỳ · đơn vị
  R4 --> R5 : DQ rules (miền giá trị ·\ntổng thành phần · bất thường)
  R5 --> R6 : có cảnh báo, hoặc số trích từ PDF\n→ bắt buộc người duyệt
  R5 --> R7 : nguồn API/SDMX sạch,\nkhông cần duyệt tay
  R6 --> R7 : maker + checker phê duyệt
  R6 --> R3 : trả lại để trích xuất lại
  R7 --> R8 : phát hiện sai sau phát hành\n(có lý do, có audit)
  R7 --> [*]
}
note bottom of M2
  **Append-only**: số điều chỉnh là observation mới gắn release mới,
  không ghi đè bản cũ. `observation.published` kích hoạt tính lại chỉ số,
  xoá cache và chạy eval regression.
end note

state "3 · Nhiệm vụ duyệt — review_task" as M3 {
  state "queued" as V1
  state "assigned" as V2
  state "edited" as V3
  state "submitted" as V4
  state "approved" as V5 #EEF7EE
  state "rejected" as V6
  [*] --> V1 : `validation.completed`
  V1 --> V2 : gán theo nguồn/domain
  V2 --> V3 : maker sửa giá trị kèm lý do\n(ghi `value_edit`, giữ giá trị gốc)
  V2 --> V4 : không cần sửa, gửi duyệt
  V3 --> V4 : gửi duyệt
  V4 --> V5 : checker ≠ maker phê duyệt
  V4 --> V6 : checker trả lại kèm lý do
  V6 --> V2
  V5 --> [*]
}

state "4 · Cảnh báo — alert" as M4 {
  state "open" as A1
  state "acknowledged" as A2
  state "resolved" as A3 #EEF7EE
  state "false_positive" as A4
  [*] --> A1 : chạm ngưỡng · bất thường ·\nquá SLA nguồn · lệch đối chiếu
  A1 --> A2 : chuyên viên phụ trách xác nhận
  A2 --> A3 : xử lý xong, ghi nhận định
  A2 --> A4 : do lỗi dữ liệu → tạo issue,\nđóng kèm lý do
  A3 --> [*]
  A4 --> [*]
}
note bottom of M4
  Ngưỡng chọn theo **kỳ dữ liệu**, không theo ngày hỏi: kỳ 2025
  không được áp ngưỡng NQ 26/2026 (hiệu lực 2026–2030).
end note

@enduml
