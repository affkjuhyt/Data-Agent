  component "Warehouse\nPostgres/Snowflake/ClickHouse" <<have>>
  component "Web ingest (1 URL)" <<partial>>
  component "Import xlsx/csv (1 bảng)" <<partial>>
  component "OCR · trang/bbox" <<missing>>
  component "Connector API/SDMX" <<missing>>
  component "Scheduler thu thập" <<missing>>
  component "Source registry" <<missing>>
  component "Mapping · chuẩn hoá" <<missing>>
