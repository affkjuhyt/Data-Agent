@startuml 01-current-architecture
title Data-Agent — Kiến trúc hiện tại (09/2026)
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 260
skinparam ArrowColor #555555
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
}
skinparam component<<gap>> {
  BackgroundColor #FDECEC
  BorderColor #C62828
  FontColor #8E1B1B
}

actor "Lãnh đạo / Chuyên viên" as User
actor "Data / AI engineer" as Eng

package "Frontend (React, hash routes)" {
  component "Ask Data\n(câu trả lời · biểu đồ · evidence · trích dẫn · xlsx)" as Ask
  component "Knowledge Ops\n(upload · bronze→gold · conflicts ·\nwarehouse wizard: snowflake/databricks)" as KOps
  component "Agent Builder · Playground · Traces" as Builder
  component "Settings · IAM · Audit" as Settings
}

component "Kong Gateway" as Kong
component "Keycloak" as KC

package "workflow-runtime" {
  component "Orchestrator\ninput_refine → route → ToT planner\n→ execute → summary → suggestion" as Orch
  component "Agent graph\nplanner → kb_search | db_connector | mcp | tool\n→ rrf/rerank → responder → judge → visualization" as AgentG
  component "Semantic layer\n(1 bảng · 1 cột · sum/count/avg/min/max)" as Sem
  component "Text-to-SQL + schema catalog\n(dialect: postgres, clickhouse)" as T2S
  component "Guardrail · Memory · Evidence/Provenance" as Guard
}

package "kb-backend + Kafka workers" {
  component "Ingestion bronze→silver→gold\n(Docling, OCR tắt, không lưu trang/bbox)" as Ingest
  component "Retrieval hybrid + rerank" as Retr
  component "Structured import\n(xlsx/csv, 1 bảng lớn nhất/file)" as Struct
  component "Web ingest (1 URL, không lịch)" as Web
  component "Conflicts · Entity graph" as Conf
}

component "sandbox-executor\n(SQL read-only · Python)" as Sandbox
component "schema-crawler\n(24h · Kafka ddl.changes)" as Crawler
component "flow-builder" as Flow
component "model-service\n(embed/rerank proxy)" as MS
component "LiteLLM" as LLM

package "GPU A100 40GB (docker run)" {
  component "vLLM Qwen3-14B-AWQ\n(responder · text_to_sql · orchestrator)" as V14
  component "vLLM Qwen3-4B-AWQ\n(planner · judge · guardrail · suggest)" as V4
  component "TEI bge-m3" as Emb
  component "TEI bge-reranker-v2-m3" as Rr
}

database "Postgres" as PG
database "Qdrant" as QD
database "Neo4j" as N4
database "MinIO" as S3
queue "Kafka" as KF
database "Redis · Mongo" as RM
database "OpenBao" as Bao
database "Langfuse" as LF
database "Warehouse\nPostgres · Snowflake · ClickHouse" as DW

component "CHƯA CÓ\nIndicator registry · Observation/vintage store · Source registry\nScheduler dữ liệu · API/SDMX connector · OCR/VLM\nEval số có dung sai · Threshold/Alert engine" <<gap>> as Gap

User --> Ask
Eng --> KOps
Eng --> Builder
Ask --> Kong
KOps --> Kong
Builder --> Kong
Settings --> Kong
Kong --> KC
Kong --> Orch
Kong --> Ingest
Kong --> Flow
Orch --> AgentG
AgentG --> Sem
AgentG --> T2S
AgentG --> Guard
Sem --> Sandbox
T2S --> Sandbox
Sandbox --> DW
Sandbox --> Bao
AgentG --> Retr : kb_search
Retr --> MS : rerank
Orch --> LLM
AgentG --> LLM
LLM --> V14
LLM --> V4
LLM --> Emb
MS --> Emb
MS --> Rr
Ingest --> S3
Ingest --> QD
Ingest --> N4
Ingest --> KF
Web --> Ingest
Struct --> PG
Conf --> QD
Crawler --> DW
Crawler --> QD
Orch --> PG
Orch --> RM
Orch --> LF
@enduml
