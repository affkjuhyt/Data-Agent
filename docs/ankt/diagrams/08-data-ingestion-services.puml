@startuml 08-data-ingestion-services
title Lớp dữ liệu đầu vào — các service và luồng sự kiện
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 230
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}

package "1. Điều khiển" {
  component "source-registry-svc\n(nguồn · cơ quan · giấy phép ·\nphân loại · lịch công bố · SLA)" <<new>> as SR
  component "scheduler (Dagster)\n(lịch · sensor · retry · backfill)" <<new>> as SCH
}

package "2. Thu thập" {
  component "connector-runtime (plugin)\n• http-file · web-crawl + diff\n• rest-api · sdmx\n• db-incremental / CDC\n• sftp / email · upload thủ công" <<new>> as CR
  component "artifact-store\n(MinIO · SHA-256 · phiên bản)" <<extend>> as AS
}

package "3. Trích xuất" {
  component "document-extraction-svc\n(layout · OCR · table · VLM →\ntrang/bbox/ô · độ tin cậy)" <<new>> as DE
  component "structured-parser-svc\n(xlsx nhiều sheet/bảng · csv ·\njson · SDMX)" <<extend>> as SP
  component "KB pipeline bronze→silver→gold\n(văn bản cho retrieval)" <<reuse>> as KBP
}

package "4. Chuẩn hoá" {
  component "mapping-svc\n(ô/cột → biến · chiều · kỳ · đơn vị ·\nLLM gợi ý + quy tắc đã duyệt)" <<new>> as MAP
  component "normalization-svc\n(bội số · FX · kỳ · codelist)" <<new>> as NORM
}

package "5. Chất lượng" {
  component "validation-svc\n(DQ rules · bất thường ·\ntổng thành phần = tổng)" <<new>> as VAL
  component "reconciliation-svc\n(so nguồn · so release trước ·\ntự tính vs chính thức)" <<new>> as REC
  component "review-svc\n(hàng đợi · maker–checker)" <<new>> as REV
}

package "6. Phát hành" {
  component "publisher-svc\n(append observation ·\nrelease/vintage · không ghi đè)" <<new>> as PUB
  component "catalog & lineage-svc" <<new>> as LIN
  component "Consumer: recompute · alert ·\neval regression · thông báo" <<new>> as DOWN
}

database "Observation store\n(ClickHouse)" as OBS
database "Registry · review\n(Postgres)" as PG
database "Qdrant · Neo4j" as VEC

SR --> SCH : lịch công bố
SCH --> CR : chạy job
CR --> AS : source.release.detected
AS ..> DE : artifact.stored (PDF/ảnh)
AS ..> SP : artifact.stored (xlsx/API)
AS ..> KBP : artifact.stored (văn bản)
DE ..> MAP : extraction.completed
SP ..> MAP : extraction.completed
MAP --> NORM
NORM ..> VAL : mapping.proposed
VAL --> REC
REC ..> REV : validation.completed
REV ..> PUB : review.approved
PUB --> OBS
PUB --> LIN
PUB ..> DOWN : observation.published
KBP --> VEC
SR --> PG
REV --> PG
LIN --> PG

legend bottom
  Mũi tên nét đứt = sự kiện qua Kafka (mang source_id · release_id · artifact_sha256 · trace_id)
endlegend
@enduml
