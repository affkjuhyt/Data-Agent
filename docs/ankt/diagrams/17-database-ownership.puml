@startuml 17-database-ownership
title Database và quyền sở hữu dữ liệu theo service
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 240
skinparam ArrowColor #555555
skinparam component<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam database<<new>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}
left to right direction

package "Service" {
  component "workflow-runtime" <<extend>> as WR
  component "flow-builder · auth-api" as FB
  component "kb-backend + workers" <<extend>> as KB
  component "indicator-catalog-svc" <<new>> as CAT
  component "observation-svc" <<new>> as OBS
  component "compute-svc" <<new>> as CMP
  component "alert · notification · report" <<new>> as ANR
  component "source-registry · mapping ·\ndata-quality · curation · extraction" <<new>> as ING
  component "Dagster" <<new>> as DAG
  component "metadata-lineage-svc" <<new>> as LIN
  component "eval-svc" <<new>> as EVAL
}

package "Postgres cluster (dataagent)" {
  database "platform · auth\n(agents · workflows · conversations · audit)" as PG_PLAT
  database "kb · semantic\n(documents · blocks · source_document ·\nkb_structured · metric contracts)" as PG_KB
  database "indicator\n(taxonomy · indicator · version · variable ·\nformula · threshold · codelist)" <<new>> as PG_IND
  database "observation\n(series · release · retraction)" <<new>> as PG_OBS
  database "ingest_*\n(source · extraction · mapping ·\ndq · review)" <<new>> as PG_ING
  database "alert · notification · report · eval" <<new>> as PG_OPS
  database "dagster (run storage)" <<new>> as PG_DAG
}

database "ClickHouse · obs\n(observation · indicator_value)" <<new>> as CH
database "Qdrant\n(knowledge · schema_catalog · memory ·\nindicator_index)" as QD
database "Neo4j\n(entity graph · concept · lineage)" as N4
database "MinIO\n(knowledge-base · ankt-raw ·\nankt-derived · reports · exports)" as S3
database "Redis\n(session · query cache ·\nrate limit · pub/sub)" as RD
database "Langfuse\n(traces · datasets · scores)" as LF
database "OpenBao\n(credential connector/warehouse)" as BAO
database "Mongo (canvas)" as MG

WR --> PG_PLAT
WR --> RD
WR --> QD
WR --> LF
WR --> S3
FB --> PG_PLAT
FB --> MG
FB --> BAO
KB --> PG_KB
KB --> S3
KB --> QD
KB --> N4
CAT --> PG_IND
CAT --> QD
CAT --> N4
OBS --> PG_OBS
OBS --> CH
OBS --> RD
CMP --> CH
CMP --> RD
ANR --> PG_OPS
ANR --> S3
ANR --> RD
ING --> PG_ING
ING --> S3
ING --> BAO
DAG --> PG_DAG
DAG --> S3
LIN --> N4
EVAL --> PG_OPS
EVAL --> LF
@enduml
