@startuml 13-poc-architecture
title POC ANKT (5 tuần) — phạm vi tối thiểu trên hạ tầng Data-Agent hiện có
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 250
skinparam ArrowColor #555555
skinparam component<<reuse>> {
  BackgroundColor #EEF7EE
  BorderColor #4E8A4E
}
skinparam component<<extend>> {
  BackgroundColor #E6F0FF
  BorderColor #2F6FB3
}
skinparam component<<poc>> {
  BackgroundColor #FFF4D6
  BorderColor #C08A00
}

legend top right
  |= Màu |= Ý nghĩa |
  |<#EEF7EE> | Dùng lại nguyên trạng |
  |<#E6F0FF> | Mở rộng nhỏ |
  |<#FFF4D6> | Xây mới cho POC |
endlegend

package "Nguồn (xem DATA-SOURCES.md)" {
  component "API/SDMX\nIMF · World Bank · BIS · Comtrade" as SrcAPI
  component "File\nPDF bản tin nợ công · niên giám\nDOCX/XLSX/XLS NSO" as SrcFile
  component "Web / XML / RSS\nSBV · Vietcombank · HNX · baochinhphu" as SrcWeb
  component "Văn bản pháp luật\nVBHN 59/2026 · NQ 26/2026 (upload)" as SrcLegal
}

package "Ingestion POC (K8s CronJob · Python)" {
  component "ankt-connectors\n(api · sdmx · http-file · xml · rss)" <<poc>> as Conn
  component "Docling + OCR baseline\n(trang · bbox · bảng)" <<extend>> as Docling
  component "Review bảng trích xuất\n(màn duyệt đơn giản)" <<poc>> as Review
  component "KB ingestion (văn bản, pháp luật)" <<reuse>> as KBI
}

package "Dữ liệu POC (Postgres schema ankt)" {
  database "indicator · variable · formula_input\nthreshold (theo kỳ)" as Reg
  database "source_document · release\nobservation (vintage · source_ref)" as Obs
  database "MinIO: file gốc + SHA-256" as S3
}

package "Agent (workflow-runtime)" {
  component "Orchestrator + route (fast path)" <<extend>> as Orch
  component "Indicator tools\nsearch · get · query · compare_threshold ·\ndecompose_change · get_source" <<poc>> as Tools
  component "Verifier số (dung sai)" <<extend>> as Ver
  component "indicator-mcp (demo MCP chuẩn)" <<poc>> as MCP
  component "Responder · evidence frame + trang" <<extend>> as Resp
}

package "Giao diện" {
  component "Ask Data + thẻ chỉ số + trích dẫn trang" <<extend>> as UIAsk
  component "Trang chỉ số Nợ công/GDP\n(chuỗi · dải ngưỡng · vintage · nguồn)" <<poc>> as UIInd
  component "Trang Nguồn dữ liệu\n(connector · lần chạy · định dạng · số bản ghi)" <<poc>> as UISrc
}

package "Đánh giá" {
  component "Golden set v1 (40–60 case)\n+ scorer dung sai" <<poc>> as Eval
  component "Langfuse traces/datasets" <<reuse>> as LF
  component "k6 load test (tests/loadtest)" <<extend>> as K6
}

SrcAPI --> Conn
SrcWeb --> Conn
SrcFile --> Conn
Conn --> S3
Conn --> Docling
Docling --> Review
Review --> Obs
Conn --> Obs : API/XLSX (không cần OCR)
SrcLegal --> KBI
Conn --> Reg : seed YAML ECO-001.5

Orch --> Tools
Tools --> Reg
Tools --> Obs
Tools --> KBI
Orch --> Resp
Resp --> Ver
MCP --> Tools

UIAsk --> Orch
UIInd --> Tools
UISrc --> Conn
UISrc --> Review
Eval --> Orch
Eval --> LF
K6 --> Orch
@enduml
