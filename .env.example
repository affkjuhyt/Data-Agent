# --- Infrastructure (docker-compose) ---
POSTGRES_DB=dataagent
POSTGRES_USER=admin
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://admin:<password>@localhost:5432/dataagent
MONGODB_URL=mongodb://localhost:27017/dataagent
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
OPENBAO_IMAGE=openbao/openbao:latest
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
# Rootless Docker-in-Docker sidecar for sandbox-executor (docs/Sandbox_SchemaCrawler_Implementation.md §8.7)
SANDBOX_DOCKERD_IMAGE=docker:27-dind-rootless
SANDBOX_DOCKERD_CLI_IMAGE=docker:27-cli

# --- Kong admin network (single source of truth) ---
# Kong's Admin API binds ONLY to its interface on the internal kong-admin-net,
# so containers on the default net cannot reach it. KONG_ADMIN_IP MUST fall
# inside KONG_ADMIN_SUBNET — if it doesn't, `docker compose up` fails loudly
# instead of silently. Clients reach the admin API via the `kong-admin` DNS
# alias, so only the kong service itself references the IP.
KONG_ADMIN_SUBNET=172.30.0.0/24
KONG_ADMIN_IP=172.30.0.10

# --- DB RBAC ---
# runtime_writer chỉ có INSERT/SELECT trên conversations, messages, agent_traces
RUNTIME_DB_PASSWORD=
RUNTIME_DB_URL=postgresql+asyncpg://runtime_writer:<password>@localhost:5432/dataagent

# --- Observability (shared/observability.py) ---
# Every service emits JSON logs (with trace_id/span_id) and exports OpenTelemetry
# spans over OTLP/gRPC to Jaeger. The compose stack already sets these per service;
# override here only when running a service outside compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Set to 1/true to turn off span export entirely (logs still emit). Leave unset in prod.
OTEL_SDK_DISABLED=

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
EMBEDDING_DIM=1024

# --- LiteLLM Gateway ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MASTER_KEY=

# --- LLM Provider ---
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Postgres backup (deploy/docker/docker-compose.prod.yml `postgres-backup`) ---
# Read by the prod overlay only. Both numbers are quoted as the RPO in
# docs/disaster-recovery.md — change them there too, and in the CronJob
# schedule in k8s/postgres-backup.yaml, or the stated RPO stops being true.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7

# --- Guardrail (backend/services/workflow-runtime/orchestrator/nodes/guardrail.py) ---
# Khi lớp LLM check hỏng VÀ regex không khớp gì: false = cho request đi tiếp
# (ưu tiên availability, mặc định), true = chặn và báo lỗi kiểm duyệt.
# Bảng "Guardrails".conditions.fail_closed ghi đè giá trị này theo tenant.
GUARDRAIL_FAIL_CLOSED=false

# --- Knowledge Base (set khi KB service sẵn sàng) ---
KB_ENDPOINT=
KB_MODE=hybrid
KB_TOP_K=10
KB_MAX_DEPTH=3

# --- App ---
DEV_SYSTEM_PROMPT=You are a helpful assistant for GTEL platform.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_TENANT_ID=
DEV_AGENT_VER_ID=
DEV_AGENT_ID=
MEMORY_RETENTION_DAYS=90
MEMORY_CLEANUP_BATCH_SIZE=1000

# --- Langfuse (observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME

# --- Langfuse default account (tạo tự động khi container khởi động lần đầu) ---
LANGFUSE_INIT_EMAIL=admin@example.com
LANGFUSE_INIT_PASSWORD=CHANGE_ME
LANGFUSE_INIT_NAME=Admin
LANGFUSE_INIT_ORG=GTEL
LANGFUSE_INIT_PROJECT=data-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me

# ── Keycloak (frontend) ─────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=aeroflow
VITE_KEYCLOAK_CLIENT=aeroflow-frontend

# ── Frontend service URLs (frontend/src/lib/config.ts) ───────────────
# Base URLs the UI calls directly. Defaults target the local dev ports; override
# when the services live elsewhere. VITE_API_URL is the Kong gateway (KB backend).
VITE_API_URL=http://localhost:8000
VITE_FLOW_BUILDER_URL=http://localhost:8002
VITE_WORKFLOW_RUNTIME_URL=http://localhost:8001

# ── Microsoft Entra ID SSO (optional — leave blank to disable) ──
# App Registration: portal.azure.com → Entra ID → App registrations → AeroFlow SSO
MS_SSO_CLIENT_ID=eb17bbd2-7522-4441-a38f-a15f21862b4c
MS_SSO_CLIENT_SECRET=CHANGE_ME
MS_SSO_TENANT_ID=consumers

# ── Kafka service passwords ──────────────────────────────────
# Must match the passwords in deploy/docker/kafka/kafka-broker-jaas.config.
# Copy this file to .env and fill in real values — never commit .env.
KAFKA_ADMIN_PASSWORD=CHANGE_ME
AUDIT_CONSUMER_KAFKA_PASSWORD=CHANGE_ME
RELEASE_WORKER_KAFKA_PASSWORD=CHANGE_ME
CI_SERVICE_KAFKA_PASSWORD=CHANGE_ME
DRIFT_DETECTOR_KAFKA_PASSWORD=CHANGE_ME
SCAN_RUNNER_KAFKA_PASSWORD=CHANGE_ME
NOTIFICATION_CONSUMER_KAFKA_PASSWORD=CHANGE_ME
WORKFLOW_RUNTIME_KAFKA_PASSWORD=CHANGE_ME
MEMORY_CONSUMER_KAFKA_PASSWORD=CHANGE_ME
SCHEMA_CRAWLER_WORKER_KAFKA_PASSWORD=CHANGE_ME

# --- Code Interpreter Sandbox (sandbox_schema_docs.docx §I) ---
# sandbox-executor is internal-only (no host port); workflow-runtime reaches
# it at http://sandbox-executor:8500 inside the compose network.

# --- Schema Crawler Worker (sandbox_schema_docs.docx §II) ---
# The crawler fills the Schema Catalog for EVERY engine the DB Connector node can
# query — Snowflake, Postgres and ClickHouse. It used to crawl Snowflake only,
# which is why the catalog described one set of databases while the agent queried
# another and every SQL generation fell back to dumping information_schema.
#
# Gap: KBWarehouseConfig.config never persists a warehouse password (see
# backend/services/kb_backend warehouse-connect flow) — no secrets-store integration
# exists yet for per-tenant warehouse credentials. Shared crawler-account
# passwords until that exists, ONE PER ENGINE: a Snowflake account is not a
# Postgres account, and falling back across them would send the wrong credential
# to the wrong host.
#
# Per-warehouse override, any engine (hyphens -> underscores, since env names
# cannot contain "-"):  WAREHOUSE_PASSWORD__<warehouse_id>
SNOWFLAKE_CRAWLER_PASSWORD=
POSTGRES_CRAWLER_PASSWORD=
CLICKHOUSE_CRAWLER_PASSWORD=

# --- Service-to-service identity (backend/libs/shared/service_identity.py) ---
# Shared HMAC secret. workflow-runtime signs an assertion carrying the REAL
# caller's tenant/user/roles; kb-backend verifies it and takes identity only
# from the token. Replaces the hardcoded admin role set kb_search used to send,
# which made kb-backend's document-level RBAC unenforceable for agent traffic.
#   Generate: openssl rand -hex 32
# Unset => kb_search cannot mint an assertion and returns no chunks (fail-closed),
# and kb-backend rejects every assertion. Set the SAME value on both services.
SERVICE_AUTH_SECRET=
# Services allowed to assert an end user's identity to kb-backend. Every entry
# can act as any user — keep this list minimal.
KB_ALLOWED_SERVICES=workflow-runtime

# Which services each backend accepts an identity assertion from. Every entry
# can act as any user, so keep these minimal.
#   workflow-runtime <- nothing. The orchestrator runs inside it (/api/orchestrate)
#   and calls the runtime in-process, so the assertion route stays shut.
RUNTIME_ALLOWED_SERVICES=
# flow-builder (agent/workflow CRUD). Empty: nothing calls it service-to-service,
# so only the Kong route is open. It was published on host port 8002 with no
# authentication at all until this was added.
FLOW_BUILDER_ALLOWED_SERVICES=

# Proof that a request carrying X-Kong-Verified actually came through Kong.
# Read by deploy/docker/kong/kong-setup.sh (registers it as the aeroflow-jwks plugin's
# gateway_key) and by EVERY upstream (kb-backend, orchestrator, workflow-runtime,
# auth-api, release-worker). Without it, any caller able to reach a service port
# can send `X-Kong-Verified: true` and be believed. Re-run kong-setup.sh after
# changing this.
#   Generate: openssl rand -hex 32
GATEWAY_KEY=
# Deprecated alias for GATEWAY_KEY, still read as a fallback. Prefer GATEWAY_KEY —
# the value is the gateway's, not kb-backend's.
KB_GATEWAY_KEY=

# --- Mutual TLS, workflow-runtime -> kb-backend (optional) ---
# Run `bash deploy/docker/certs/gen-certs.sh` first. Paths are INSIDE the container
# (deploy/docker/certs is mounted read-only at /certs). Set both cert and key or
# neither — half-configured raises at startup instead of quietly connecting
# without a client certificate. Requires kb-backend to be served over TLS with
# client-cert verification; see deploy/docker/certs/gen-certs.sh for the uvicorn flags.
MTLS_CLIENT_CERT=
MTLS_CLIENT_KEY=
MTLS_CA_CERT=

# ── Tenant isolation (row-level security) ─────────────────────────────────
# The role the tenant_isolation policies are written for. Migration
# a1b2c3d4e5f6 enables + FORCEs RLS on every tenant-scoped table, but a
# SUPERUSER bypasses RLS unconditionally and FORCE does not change that — so
# while services connect as POSTGRES_USER (a superuser), the policies are
# inert and isolation rests on explicit WHERE clauses alone.
#
# Set this to the app_user DSN (deploy/docker/sql/grant-app-user.sql) to make RLS
# effective. Adopt it per service: any query that does not set app.tenant_id
# returns ZERO rows under this role instead of every tenant's.
# APP_DATABASE_URL=postgresql://app_user:app_user_dev_pw@postgres:5432/dataagent

# Turns "this scoped session cannot be enforced" from a warning into a refusal.
# Enable once a deployment has finished moving off the superuser DSN — it is
# what stops a later change from silently reverting to an unenforced connection.
STRICT_TENANT_ISOLATION=0
