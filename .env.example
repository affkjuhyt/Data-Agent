# --- Infrastructure (deploy/docker/*.yml) ---
POSTGRES_DB=dataagent
POSTGRES_USER=admin
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Keycloak admin username (defaults to "admin").
#KEYCLOAK_ADMIN=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
# MinIO access-key user; also embedded in the MINIO_URL each service builds (defaults to "minio").
#MINIO_ROOT_USER=minio
# OpenBao AppRole credentials of a service run on the host (blank = static OPENBAO_TOKEN).
#OPENBAO_ROLE_ID=
#OPENBAO_SECRET_ID=

# --- ClickHouse (Langfuse v3 analytics store, clickhouse.yml) ---
#CLICKHOUSE_USER=clickhouse
#CLICKHOUSE_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://admin:<password>@localhost:8300/dataagent
REDIS_HOST=localhost
REDIS_PORT=6379

# --- DB RBAC ---
# Three non-owner roles. The password below IS the one embedded in the DSN
# beside it — deploy/k8s/production/job/db-init.yaml runs ALTER ROLE with these values,
# so the role and the DSN cannot drift apart. Same key names as
# deploy/k8s/secrets.env.example.
#
# runtime_writer chỉ có INSERT/SELECT trên conversations, messages, agent_traces
RUNTIME_WRITER_PASSWORD=
RUNTIME_DB_URL=postgresql+asyncpg://runtime_writer:<RUNTIME_WRITER_PASSWORD>@localhost:8300/dataagent


# Optional gateway smoke check in deploy/k8s/production/job/setup.yaml. Blank = skipped.
# Must match the Keycloak dev user password kong-setup.sh sets.
SMOKE_PASSWORD=

# --- Vector DB ---
EMBEDDING_DIM=1024

# --- LiteLLM Gateway ---
LITELLM_BASE_URL=http://localhost:8500
LITELLM_API_KEY=
LITELLM_MASTER_KEY=

# --- GPU model server (vLLM + TEI, qua VPN) ---
# deploy/docker/litellm/config.yaml đọc các *_BASE_URL này qua `os.environ/`;
# Đổi embed backend = đổi vector space → phải re-ingest các collection KB cũ.
LLM_MAIN_BASE_URL=http://<gpu-host>:8001/v1
LLM_FAST_BASE_URL=http://<gpu-host>:8002/v1
EMBEDDING_V1_BASE_URL=http://<gpu-host>:8003/v1

# --- LLM Provider ---
LLM_API_KEY=

# --- Postgres backup (deploy/docker/postgres-backup.yml) ---
# Read by the prod overlay only. Both numbers are quoted as the RPO in
# docs/disaster-recovery.md — change them there too, and in the CronJob
# schedule in k8s/postgres-backup.yaml, or the stated RPO stops being true.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7

# --- Eval runner (the eval Job, model/eval): agent + tenant the eval suite targets ---
#EVAL_AGENT_ID=
#EVAL_TENANT_ID=dev-tenant

# --- Langfuse (observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:8420
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
# 64-hex-char key Langfuse v3 uses to encrypt stored secrets (openssl rand -hex 32).
#LANGFUSE_ENCRYPTION_KEY=

# --- Langfuse default account (tạo tự động khi container khởi động lần đầu) ---
LANGFUSE_INIT_EMAIL=admin@example.com
LANGFUSE_INIT_PASSWORD=CHANGE_ME
LANGFUSE_INIT_NAME=Admin
LANGFUSE_INIT_ORG=GTEL
LANGFUSE_INIT_PROJECT=data-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me

# ── Keycloak (frontend) ─────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:30110
VITE_KEYCLOAK_REALM=aeroflow
VITE_KEYCLOAK_CLIENT=aeroflow-frontend
# Alias of the Microsoft Entra ID identity provider in the realm. Set, the login page shows
# "Đăng nhập với Microsoft Entra ID" and goes straight to it (kc_idp_hint); blank, the button is
# hidden. The provider must be enabled in Keycloak, or the hint ends on an error page.
VITE_KEYCLOAK_ENTRA_IDP=
# Shown in the login page footer ("môi trường Production"); blank = left out.
VITE_ENVIRONMENT_LABEL=

# ── Frontend service URLs (frontend/src/lib/config.ts) ───────────────
# Base URLs the UI calls directly. Defaults target the local dev ports; override
# when the services live elsewhere. VITE_API_URL is the Kong gateway (KB backend).
VITE_API_URL=http://localhost:30100
# Dev only: 1 answers the v1 API of the system design (/v1/inbox, /v1/agents, …) from
# frontend/src/mocks until the backend serves it (docs/v3/05-ui-v3.md §4). Login is still real.
VITE_MOCK_V1=0


# ── Kafka service passwords ──────────────────────────────────
# Must match the passwords in deploy/docker/kafka/kafka-broker-jaas.config.
# Copy this file to .env and fill in real values — never commit .env.
KAFKA_ADMIN_PASSWORD=CHANGE_ME

# Proof that a request carrying X-Kong-Verified actually came through Kong.
# Read by deploy/docker/kong/kong-setup.sh, which registers it as the aeroflow-jwks plugin's
# gateway_key. Re-run kong-setup.sh after changing this.
#   Generate: openssl rand -hex 32
GATEWAY_KEY=

# ── Stores ─────────────────────────────────────────────────────────────────
# The db-init Job sets app_user's password from this.
APP_USER_PASSWORD=
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
# worker-document's raw and derived document objects (services/worker_document/storage.py).
MINIO_URL=http://minioadmin:minioadmin@minio:9000
MINIO_MAX_CONNECTIONS=10

# ── PgBouncer ─────────────────────────────────────────────────────────────
# Transaction pooling: forwards the client role, so RLS still applies.
PGBOUNCER_AUTH_PASSWORD=
