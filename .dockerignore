# A bare name only matches at the context root; `**/` makes it match at any
# depth. Without it every service's own .venv, __pycache__ and node_modules
# rode along into the context of each image built from the repo root.
.git
.gitignore
.idea
.claude
**/.venv
**/venv
**/node_modules
**/dist
**/build
**/coverage
**/logs
archive
docs
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.pyc
**/*.pyo
**/*.log
**/.env
**/.env.local
**/.env.*
!**/.env.example
**/*.egg-info
**/.DS_Store
model/ollama/weights
